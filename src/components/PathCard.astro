---
import { OfferingKind } from '../lib/constants';

/*
 * The artifact for one path, as the member would actually meet it.
 *
 * Three cards, one per core thing the product does. Each shows the single
 * moment that path turns on: the request form with its optional thank-you
 * already visible, the incoming request a referrer can claim, and the opening
 * that arrives before the role is public.
 *
 * The thank-you sits on the ASK card and nowhere else, because that is where
 * the product puts it. An earlier version showed it at the end of the flow,
 * after the referral had landed, which misrepresented the one part of this
 * product that involves money.
 */
interface Props {
	readonly kind: OfferingKind;
}

const { kind } = Astro.props;
---

<div class="path-card glass" aria-hidden="true">
	{
		kind === OfferingKind.AskForReferral && (
			<div class="pc-body">
				<header class="pc-head">
					<span class="pc-label mono">New request</span>
					<span class="pc-pill">Free to send</span>
				</header>

				<p class="pc-role">Product Manager</p>
				<p class="pc-meta">Microsoft &middot; Bengaluru</p>

				<ul class="pc-rows">
					<li>
						<span>Resume</span>
						<em>Attached</em>
					</li>
					<li>
						<span>Who sees it</span>
						<em>3 verified employees</em>
					</li>
				</ul>

				<div class="pc-tip">
					<div class="pc-tip-head">
						<span>Say thank you</span>
						<em>optional</em>
					</div>
					<ul class="pc-tiers">
						<li>Nothing</li>
						<li class="is-selected">Coffee &middot; &#8377;100</li>
						<li>Meal &middot; &#8377;500</li>
					</ul>
				</div>

				<span class="pc-action">Send request</span>
			</div>
		)
	}

	{
		kind === OfferingKind.GiveReferral && (
			<div class="pc-body">
				<header class="pc-head">
					<span class="pc-label mono">Someone is asking</span>
					<span class="pc-pill">48h to act</span>
				</header>

				<p class="pc-role">Product Manager</p>
				<p class="pc-meta">6 years, fintech and payments</p>

				<ul class="pc-rows">
					<li>
						<span>Their resume</span>
						<em>Visible once claimed</em>
					</li>
					<li>
						<span>Proof needed</span>
						<em>One screenshot</em>
					</li>
				</ul>

				<div class="pc-proof">
					<span class="pc-shot"><i /><i /><i /></span>
					<span class="pc-stamp mono">14:32</span>
				</div>

				<span class="pc-action">Claim request</span>
			</div>
		)
	}

	{
		kind === OfferingKind.PeerSignal && (
			<div class="pc-body">
				<span class="pc-sonar"><i /><i /><i /></span>

				<header class="pc-head">
					<span class="pc-label mono">New opening</span>
					<span class="pc-pill">18m ago</span>
				</header>

				<p class="pc-role">Staff Data Engineer</p>
				<p class="pc-meta">Stripe &middot; Bengaluru</p>

				<ul class="pc-rows">
					<li>
						<span>Status</span>
						<em>Not posted publicly yet</em>
					</li>
					<li>
						<span>Referral path</span>
						<em>Available</em>
					</li>
				</ul>

				<span class="pc-action">Ask for a referral</span>
			</div>
		)
	}
</div>

<style>
	.path-card {
		display: grid;
		padding: clamp(1.5rem, 2.6vw, 1.875rem);
		border-radius: var(--radius-lg);
	}

	.pc-body {
		position: relative;
		display: grid;
		gap: 0.875rem;
		align-content: start;
		isolation: isolate;
	}

	.pc-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.pc-label {
		color: rgb(var(--accent-ink));
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.pc-pill {
		padding: 0.3125rem 0.625rem;
		border: 1px solid rgb(var(--accent) / 30%);
		border-radius: var(--radius-pill);
		background: rgb(var(--accent-soft));
		color: rgb(var(--accent-ink));
		font-size: 0.75rem;
		font-weight: 650;
		white-space: nowrap;
	}

	.pc-role {
		margin: 0.25rem 0 0;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.pc-meta {
		margin: -0.5rem 0 0;
		color: rgb(var(--color-muted));
		font-size: 0.875rem;
	}

	/* ---- Rows ---- */

	.pc-rows {
		display: grid;
		gap: 0;
		margin: 0.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.pc-rows li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.625rem;
		border-top: 1px solid rgb(var(--color-border) / 70%);
		font-size: 0.875rem;
	}

	.pc-rows li:last-child {
		border-bottom: 1px solid rgb(var(--color-border) / 70%);
	}

	.pc-rows span {
		color: rgb(var(--color-muted));
	}

	.pc-rows em {
		font-style: normal;
		font-weight: 600;
	}

	/* ---- The thank-you, on the request form where it belongs ---- */

	.pc-tip {
		display: grid;
		gap: 0.5rem;
		padding: 0.875rem;
		border: 1px solid rgb(var(--color-reward) / 26%);
		border-radius: var(--radius-2xl);
		background: rgb(var(--color-reward-soft) / 55%);
	}

	.pc-tip-head {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 0.875rem;
		font-weight: 650;
	}

	.pc-tip-head em {
		color: rgb(var(--color-reward-ink));
		font-size: 0.75rem;
		font-style: normal;
		font-weight: 600;
	}

	.pc-tiers {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* "Nothing" is first and the same size as the amounts, because zero is a
	   real option in the product and has to look like one here. */
	.pc-tiers li {
		padding: 0.3125rem 0.625rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-pill);
		background: rgb(var(--color-surface));
		color: rgb(var(--color-muted));
		font-size: 0.75rem;
		font-weight: 600;
	}

	.pc-tiers .is-selected {
		border-color: rgb(var(--color-reward) / 45%);
		background: rgb(var(--color-reward));
		color: rgb(var(--color-primary-ink));
	}

	/* ---- Proof ---- */

	.pc-proof {
		position: relative;
		width: fit-content;
	}

	.pc-shot {
		display: grid;
		width: 9rem;
		gap: 0.375rem;
		padding: 0.75rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-sm);
		background: rgb(var(--color-elevated));
	}

	.pc-shot i {
		height: 0.375rem;
		border-radius: var(--radius-pill);
		background: rgb(var(--color-ink) / 12%);
	}

	.pc-shot i:first-child {
		width: 70%;
		background: rgb(var(--color-ink) / 24%);
	}

	.pc-shot i:last-child {
		width: 45%;
	}

	.pc-stamp {
		position: absolute;
		right: -1.5rem;
		bottom: -0.5rem;
		padding: 0.3125rem 0.5625rem;
		border: 1px solid rgb(var(--accent) / 40%);
		border-radius: var(--radius-pill);
		background: rgb(var(--accent-soft));
		color: rgb(var(--accent-ink));
		font-weight: 650;
		transform: rotate(-4deg);
	}

	/* ---- Sonar ---- */

	.pc-sonar {
		position: absolute;
		z-index: -1;
		top: 0.5rem;
		left: 2rem;
		width: 0;
		height: 0;
	}

	.pc-sonar i {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 3.5rem;
		height: 3.5rem;
		border: 1px solid rgb(var(--color-sonar) / 40%);
		border-radius: 50%;
		opacity: 0;
		transform: translate(-50%, -50%) scale(0.4);
	}

	/* ---- Action ---- */

	.pc-action {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		justify-content: center;
		margin-top: 0.25rem;
		border-radius: var(--radius-pill);
		background: rgb(var(--accent));
		color: rgb(var(--color-primary-ink));
		font-size: 0.9375rem;
		font-weight: 650;
	}

	@media (prefers-reduced-motion: no-preference) {
		.pc-sonar i {
			animation: pc-sonar 2400ms var(--ease-out) infinite backwards;
		}

		.pc-sonar i:nth-child(2) {
			animation-delay: 800ms;
		}

		.pc-sonar i:nth-child(3) {
			animation-delay: 1600ms;
		}

		@keyframes pc-sonar {
			0% {
				opacity: 0.8;
				transform: translate(-50%, -50%) scale(0.35);
			}
			100% {
				opacity: 0;
				transform: translate(-50%, -50%) scale(2.2);
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pc-sonar i:first-child {
			opacity: 0.3;
			transform: translate(-50%, -50%) scale(1);
		}
	}
</style>
