---
import Brand from './Brand.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SectionId, TrackEvent } from '../lib/constants';
import { SIGNUP_URL } from '../lib/content';

interface NavItem {
	readonly label: string;
	readonly href: string;
}

const navItems: readonly NavItem[] = [
	{ label: 'How it works', href: `#${SectionId.HowItWorks}` },
	{ label: 'Peer openings', href: `#${SectionId.PeerSignal}` },
	{ label: 'Trust', href: `#${SectionId.Trust}` },
	{ label: 'FAQ', href: `#${SectionId.Faq}` },
];
---

<header class="site-header" data-site-header>
	<div class="shell header-inner">
		<Brand size="sm" class="header-brand" />

		<nav class="header-nav" aria-label="Primary" data-nav-spy>
			{navItems.map((item) => <a href={item.href}>{item.label}</a>)}
		</nav>

		<div class="header-actions">
			<ThemeToggle />
			<a class="button button-primary header-cta" href={SIGNUP_URL} data-track={TrackEvent.NavPrimary}>
				Get started
			</a>
		</div>
	</div>
</header>

<script>
	import { navSpy } from '../lib/motion';
	import { SectionId } from '../lib/constants';

	const header = document.querySelector<HTMLElement>('[data-site-header]');

	if (header) {
		const sync = (): void => {
			header.classList.toggle('is-condensed', window.scrollY > 24);
		};
		sync();
		window.addEventListener('scroll', sync, { passive: true });

		navSpy(
			header.querySelectorAll<HTMLAnchorElement>('[data-nav-spy] a'),
			document.getElementById(SectionId.Top),
		);
	}
</script>

<style>
	/*
	 * Over the hero the header is transparent; a soft blur band underneath
	 * keeps the wordmark legible against the drawing. The moment the page
	 * scrolls, the header ADDS chrome — a translucent canvas, a heavier blur
	 * and a hairline — so it never floats naked over content. Its height never
	 * changes: a shrinking sticky header shifts everything under it.
	 */
	.site-header {
		position: sticky;
		z-index: 100;
		top: 0;
		/* Let the hero background continue behind the navigation. */
		margin-bottom: -4.5rem;
		border-bottom: 1px solid transparent;
		background: transparent;
		transition:
			background-color var(--dur-mid) ease,
			border-color var(--dur-mid) ease,
			backdrop-filter var(--dur-mid) ease;
	}

	.site-header::after {
		position: absolute;
		z-index: -1;
		inset: 0 0 -1.5rem;
		background: linear-gradient(
			to bottom,
			rgb(var(--color-canvas) / 12%),
			transparent 90%
		);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		content: '';
		mask-image: linear-gradient(to bottom, #000 0%, #000 58%, transparent 100%);
		-webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 58%, transparent 100%);
		pointer-events: none;
		transition: opacity var(--dur-mid) ease;
	}

	.site-header.is-condensed {
		border-bottom-color: rgb(var(--color-border) / 70%);
		background: rgb(var(--color-canvas) / 72%);
		backdrop-filter: blur(14px) saturate(1.3);
		-webkit-backdrop-filter: blur(14px) saturate(1.3);
	}

	.site-header.is-condensed::after {
		opacity: 0;
	}

	.header-inner {
		display: flex;
		height: 4.5rem;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.header-inner :global(.header-brand) {
		transform-origin: left center;
		transition: transform var(--dur-mid) var(--ease-out);
	}

	.site-header.is-condensed .header-inner :global(.header-brand) {
		transform: scale(0.92);
	}

	.header-nav {
		display: none;
		align-items: center;
		gap: 2rem;
	}

	.header-nav a {
		position: relative;
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		color: rgb(var(--color-muted));
		font-size: 1rem;
		font-weight: 650;
		letter-spacing: -0.015em;
		transition: color var(--dur-fast) ease;
	}

	/* The section under the reader is marked by a small dot, not a bar — the
	   bar would fight the hairline the header already draws. */
	.header-nav a::after {
		position: absolute;
		bottom: 0.25rem;
		left: 50%;
		width: 0.25rem;
		height: 0.25rem;
		border-radius: 50%;
		background: rgb(var(--color-primary));
		content: '';
		transform: translateX(-50%) scale(0);
		transition: transform var(--dur-mid) var(--ease-out);
	}

	:global([data-theme='dark']) .header-nav a::after {
		background: rgb(var(--color-primary-strong));
	}

	.header-nav a:hover,
	.header-nav a[aria-current='true'] {
		color: rgb(var(--color-ink));
	}

	.header-nav a[aria-current='true']::after {
		transform: translateX(-50%) scale(1);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.header-cta {
		min-height: 2.75rem;
		padding-inline: 1.125rem;
		font-size: 0.875rem;
	}

	@media (min-width: 62rem) {
		.header-nav {
			display: flex;
		}
	}

	/* On the narrowest phones the wordmark plus a pill CTA plus the toggle is
	   too much; the nav is already hidden, so drop the CTA label weight. */
	@media (max-width: 24rem) {
		.header-cta {
			padding-inline: 0.875rem;
			font-size: 0.8125rem;
		}
	}
</style>
