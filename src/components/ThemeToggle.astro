<button
	class="theme-toggle"
	type="button"
	data-theme-toggle
	aria-label="Switch between light and dark theme"
	aria-pressed="false"
>
	<span class="theme-toggle-track" aria-hidden="true">
		<span class="theme-toggle-thumb"></span>
		<svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
			<circle cx="12" cy="12" r="4.2"></circle>
			<path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"></path>
		</svg>
		<svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
			<path d="M20.5 14.4A8.6 8.6 0 1 1 9.6 3.5a6.9 6.9 0 0 0 10.9 10.9Z"></path>
		</svg>
	</span>
</button>

<script>
	import { THEME_STORAGE_KEY, ThemeMode } from '../lib/constants';

	const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

	const readTheme = (): ThemeMode =>
		document.documentElement.dataset.theme === ThemeMode.Dark ? ThemeMode.Dark : ThemeMode.Light;

	const applyTheme = (theme: ThemeMode): void => {
		document.documentElement.dataset.theme = theme;
		toggle?.setAttribute('aria-pressed', String(theme === ThemeMode.Dark));

		const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
		meta?.setAttribute('content', theme === ThemeMode.Dark ? '#050505' : '#FBF8F2');

		// Let client islands (the Remotion players) repaint against the new tokens.
		window.dispatchEvent(new CustomEvent<ThemeMode>('rightrefer:themechange', { detail: theme }));
	};

	applyTheme(readTheme());

	toggle?.addEventListener('click', () => {
		const next = readTheme() === ThemeMode.Dark ? ThemeMode.Light : ThemeMode.Dark;
		try {
			localStorage.setItem(THEME_STORAGE_KEY, next);
		} catch {
			// Private browsing with storage disabled: the theme still applies for
			// this session, it simply will not persist.
		}
		applyTheme(next);
	});
</script>

<style>
	.theme-toggle {
		display: inline-grid;
		width: 3.5rem;
		/* Visually a 2rem track, but the hit area meets the 44px minimum. */
		height: 2.75rem;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		place-items: center;
	}

	.theme-toggle-track {
		position: relative;
		display: block;
		width: 3.5rem;
		height: 2rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-pill);
		background: rgb(var(--color-elevated));
		transition:
			background-color var(--dur-mid) ease,
			border-color var(--dur-mid) ease;
	}

	.theme-toggle:hover .theme-toggle-track {
		border-color: rgb(var(--color-primary) / 45%);
	}

	.theme-toggle-thumb {
		position: absolute;
		z-index: 1;
		top: 0.1875rem;
		left: 0.1875rem;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		background: rgb(var(--color-surface));
		box-shadow: 0 0.125rem 0.375rem rgb(var(--color-ink) / 18%);
		transition: transform var(--dur-mid) var(--ease-out);
	}

	:global([data-theme='dark']) .theme-toggle-thumb {
		transform: translateX(1.5rem);
	}

	.theme-icon {
		position: absolute;
		z-index: 2;
		top: 50%;
		width: 0.875rem;
		height: 0.875rem;
		fill: none;
		stroke: rgb(var(--color-muted));
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.9;
		transform: translateY(-50%);
		transition:
			stroke var(--dur-mid) ease,
			opacity var(--dur-mid) ease;
	}

	.theme-icon-sun {
		left: 0.5rem;
	}

	.theme-icon-moon {
		right: 0.5rem;
	}

	/* The icon under the thumb is the active one, so it must read as ink. */
	:global([data-theme='light']) .theme-icon-sun {
		stroke: rgb(var(--color-primary));
	}

	:global([data-theme='dark']) .theme-icon-moon {
		stroke: rgb(var(--color-primary-strong));
	}
</style>
