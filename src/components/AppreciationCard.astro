---
/*
 * The appreciation step, as the member meets it.
 *
 * DESIGN_SYSTEM.md §7 rule 4 permits example amounts here and nowhere else,
 * because this is the one section that describes the thing amounts belong to
 * and it sits late in the page, after the argument has been made. The rule is
 * respected exactly: two amounts, inside this card, both of them plainly
 * marked optional, and no fee, percentage or payout schedule anywhere.
 *
 * Coffee is pre-selected because the honest default is a small one, and
 * because a card of three empty tiles reads as a price list.
 */
interface Tier {
	readonly label: string;
	readonly amount: string;
	readonly icon: string;
	readonly selected?: boolean;
}

const TIERS: readonly Tier[] = [
	{ label: 'Coffee', amount: '₹100', icon: 'M4 7h9v5a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z', selected: true },
	{ label: 'Meal', amount: '₹500', icon: 'M6 4v7m0 0v9m0-9c-1.5 0-2.5-1-2.5-2.5V4M9 4v4.5C9 10 8 11 6.5 11M15 20V4c2.5 0 3.5 2 3.5 5s-1 4-3.5 4' },
	{ label: 'Custom', amount: 'Your call', icon: 'M12 5v14M5 12h14' },
];
---

<article class="appreciation-card glass reveal" aria-label="Optional appreciation, as it appears in the product">
	<header class="ac-head">
		<p class="ac-eyebrow mono">Referral confirmed</p>
		<h3 class="ac-title">Optional appreciation</h3>
	</header>

	<ul class="ac-tiers">
		{
			TIERS.map((tier) => (
				<li class:list={['ac-tier', tier.selected && 'is-selected']}>
					<span class="ac-tier-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24">
							<path d={tier.icon} />
							{tier.label === 'Coffee' && <path d="M13 8h1.5a2.5 2.5 0 0 1 0 5H13" />}
						</svg>
					</span>
					<span class="ac-tier-label">{tier.label}</span>
					<span class="ac-tier-amount">{tier.amount}</span>
				</li>
			))
		}
	</ul>

	<footer class="ac-foot">
		<span class="ac-skip">Skip</span>
		<span class="ac-send">Send thanks</span>
	</footer>
</article>

<style>
	.appreciation-card {
		display: grid;
		gap: 1.125rem;
		max-width: 26rem;
		padding: clamp(1.375rem, 2.6vw, 1.75rem);
		border-radius: var(--radius-lg);
	}

	.ac-eyebrow {
		margin: 0;
		color: rgb(var(--color-success-ink));
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	:global([data-theme='dark']) .ac-eyebrow {
		color: rgb(var(--color-success));
	}

	.ac-title {
		margin: 0.4375rem 0 0;
		font-family: var(--font-display);
		font-size: 1.625rem;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	/* ---- Tiers ---- */

	.ac-tiers {
		display: grid;
		gap: 0.625rem;
		margin: 0;
		padding: 0;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		list-style: none;
	}

	.ac-tier {
		display: grid;
		gap: 0.1875rem;
		justify-items: center;
		padding: 0.875rem 0.5rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-2xl);
		background: rgb(var(--color-surface) / 70%);
		text-align: center;
	}

	.ac-tier-icon svg {
		width: 1.25rem;
		height: 1.25rem;
		margin-bottom: 0.3125rem;
		fill: none;
		stroke: rgb(var(--color-muted));
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.ac-tier-label {
		font-size: 0.8125rem;
		font-weight: 650;
	}

	.ac-tier-amount {
		color: rgb(var(--color-muted));
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
	}

	/* Money is violet in the product — its own identity rather than a second
	   primary blue — and this is the page's only money-shaped control. */
	.ac-tier.is-selected {
		border-color: rgb(var(--color-reward) / 42%);
		background: rgb(var(--color-reward-soft));
	}

	.ac-tier.is-selected .ac-tier-icon svg {
		stroke: rgb(var(--color-reward-ink));
	}

	.ac-tier.is-selected .ac-tier-label,
	.ac-tier.is-selected .ac-tier-amount {
		color: rgb(var(--color-reward-ink));
	}

	/* ---- Foot ---- */

	.ac-foot {
		display: flex;
		align-items: center;
		gap: 0.625rem;
	}

	.ac-skip,
	.ac-send {
		display: inline-flex;
		min-height: 2.625rem;
		align-items: center;
		justify-content: center;
		border: 1px solid transparent;
		border-radius: var(--radius-pill);
		font-size: 0.875rem;
		font-weight: 650;
	}

	/*
	 * Skip is a real, equal-width option, not a dismissible afterthought. The
	 * section's whole claim is that this step is optional, and a card where
	 * the way out is smaller than the way through would contradict it.
	 */
	.ac-skip {
		flex: 1 1 0;
		border-color: rgb(var(--color-border));
		background: rgb(var(--color-surface));
		color: rgb(var(--color-muted));
	}

	.ac-send {
		flex: 1 1 0;
		background: rgb(var(--color-reward));
		color: rgb(var(--color-primary-ink));
	}

	:global([data-theme='dark']) .ac-send {
		color: rgb(var(--color-reward-soft));
	}

	/* The selected tier settles into place as the card is read: the point is
	   that a small one is the default, not that a choice has been made for
	   the reader. */
	@media (prefers-reduced-motion: no-preference) {
		.appreciation-card.is-visible .ac-tier.is-selected {
			animation: tier-settle 620ms var(--ease-spring) 520ms both;
		}

		@keyframes tier-settle {
			from {
				transform: scale(0.9);
			}
			to {
				transform: scale(1);
			}
		}
	}

	@media (max-width: 30rem) {
		.ac-tier {
			padding-inline: 0.25rem;
		}
	}
</style>
