---
import { OUTCOME_DISCLAIMER, SectionId } from '../lib/constants';
import { TRUST_PILLARS } from '../lib/content';
---

<section class="section trust" id={SectionId.Trust} aria-labelledby="trust-title">
	<div class="trust-orbit" aria-hidden="true"></div>

	<div class="shell trust-inner">
		<div class="trust-head reveal">
			<p class="eyebrow trust-eyebrow">Why this is safe to use</p>
			<h2 class="display-2" id="trust-title">Trust here is a mechanism, not a slogan.</h2>
			<p class="trust-lede">
				Every claim on this page is backed by something the product actually does. Here is exactly
				what protects both sides.
			</p>
		</div>

		<ul class="trust-grid">
			{
				TRUST_PILLARS.map((pillar) => (
					<li class="trust-card reveal">
						<span class="trust-card-rule" aria-hidden="true" />
						<h3 class="trust-card-title">{pillar.title}</h3>
						<p class="trust-card-detail">{pillar.detail}</p>
					</li>
				))
			}
		</ul>

		<p class="trust-disclaimer reveal">
			<svg viewBox="0 0 16 16" aria-hidden="true">
				<circle cx="8" cy="8" r="6.4"></circle>
				<path d="M8 5.2v3.4M8 10.6v.2"></path>
			</svg>
			{OUTCOME_DISCLAIMER}
		</p>
	</div>
</section>

<style>
	/*
	 * A mechanism-and-evidence section reads better on a light field than on a
	 * wall of dark blue — dark inverted panels read as marketing theatre, and
	 * this section's whole point is that it is not one. `--color-primary-soft`
	 * already carries the locked LinkedIn blue at low saturation in both
	 * themes, so this stays on-palette without inventing a new colour.
	 */
	.trust {
		position: relative;
		overflow: hidden;
		background: rgb(var(--color-primary-soft));
		isolation: isolate;
	}

	/* Concentric rings, echoing the reach of the network. Purely decorative and
	   cheap — no image request. */
	.trust-orbit {
		position: absolute;
		z-index: 0;
		top: 50%;
		left: 50%;
		width: min(60rem, 130vw);
		aspect-ratio: 1;
		background:
			radial-gradient(circle, transparent 29%, rgb(var(--color-primary) / 5%) 29.2%, transparent 30%),
			radial-gradient(circle, transparent 43%, rgb(var(--color-primary) / 4%) 43.2%, transparent 44%),
			radial-gradient(circle, transparent 58%, rgb(var(--color-primary) / 3%) 58.2%, transparent 59%);
		pointer-events: none;
		transform: translate(-50%, -50%);
	}

	.trust-inner {
		position: relative;
		z-index: 1;
	}

	/* ---- Head ---- */

	.trust-head {
		max-width: 42rem;
	}

	.trust-eyebrow {
		color: rgb(var(--color-primary-strong));
	}

	.trust-head .display-2 {
		color: rgb(var(--color-ink));
	}

	.trust-lede {
		max-width: 34rem;
		margin: 1.125rem 0 0;
		color: rgb(var(--color-muted));
		font-size: 1.0625rem;
		line-height: 1.65;
	}

	/* ---- Pillars ---- */

	.trust-grid {
		display: grid;
		gap: 1px;
		margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
		padding: 0;
		overflow: hidden;
		border: 1px solid rgb(var(--color-primary) / 16%);
		border-radius: var(--radius-xxl);
		background: rgb(var(--color-primary) / 14%);
		list-style: none;
	}

	.trust-card {
		display: grid;
		gap: 0.625rem;
		padding: clamp(1.5rem, 3vw, 2rem);
		background: rgb(var(--color-surface));
	}

	.trust-card-rule {
		width: 2rem;
		height: 2px;
		border-radius: var(--radius-pill);
		background: rgb(var(--color-primary) / 45%);
	}

	.trust-card-title {
		margin: 0.375rem 0 0;
		color: rgb(var(--color-ink));
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.trust-card-detail {
		margin: 0;
		color: rgb(var(--color-muted));
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	/* ---- Disclaimer ---- */

	.trust-disclaimer {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin: 1.75rem 0 0;
		color: rgb(var(--color-muted));
		font-size: 0.875rem;
	}

	.trust-disclaimer svg {
		width: 1.0625rem;
		height: 1.0625rem;
		flex: 0 0 auto;
		fill: none;
		stroke: currentcolor;
		stroke-linecap: round;
		stroke-width: 1.4;
	}

	/* ---- Responsive ---- */

	@media (min-width: 48rem) {
		.trust-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
