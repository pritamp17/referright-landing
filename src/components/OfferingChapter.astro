---
import type { Offering } from '../lib/content';

interface Props {
	offering: Offering;
	/** Odd chapters put the visual on the right, even on the left. */
	reversed?: boolean;
	trackEvent: string;
	headingId: string;
}

const { offering, reversed = false, trackEvent, headingId } = Astro.props;
const hasVisualSlot = Astro.slots.has('visual');
---

<article
	class:list={['chapter', `accent-${offering.accent}`, reversed && 'is-reversed', 'reveal']}
	aria-labelledby={headingId}
>
	<div class="chapter-copy">
		<p class="chapter-index">
			<span class="mono">{offering.index}</span>
			<span class="chapter-eyebrow">{offering.eyebrow}</span>
		</p>

		<h3 class="display-3" id={headingId}>{offering.title}</h3>
		<p class="lede">{offering.summary}</p>

		<ul class="chapter-points">
			{
				offering.points.map((point) => (
					<li>
						<svg viewBox="0 0 16 16" aria-hidden="true">
							<path d="M3.4 8.4l3 3 6.2-7" />
						</svg>
						<span>
							<strong>{point.label}</strong>
							{point.detail}
						</span>
					</li>
				))
			}
		</ul>

		<a class="text-link chapter-cta" href={offering.ctaHref} data-track={trackEvent}>
			{offering.ctaLabel}
			<svg viewBox="0 0 16 16" aria-hidden="true">
				<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
			</svg>
		</a>
	</div>

	<div class="chapter-visual">
		{
			hasVisualSlot ? (
				<slot name="visual" />
			) : (
				offering.image && (
					<div class="chapter-figure">
						<img
							src={offering.image}
							alt={offering.imageAlt ?? ''}
							width="1100"
							height="614"
							loading="lazy"
							decoding="async"
						/>
						<span class="chapter-figure-tint" aria-hidden="true" />
					</div>
				)
			)
		}
	</div>
</article>

<style>
	.chapter {
		display: grid;
		align-items: center;
		gap: clamp(2rem, 4vw, 3.5rem);
	}

	/* ---- Copy ---- */

	.chapter-index {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 1rem;
	}

	.chapter-index .mono {
		display: inline-grid;
		width: 2rem;
		height: 2rem;
		border: 1px solid rgb(var(--accent) / 30%);
		border-radius: var(--radius-sm);
		background: rgb(var(--accent-soft));
		color: rgb(var(--accent-ink));
		font-weight: 600;
		place-items: center;
	}

	.chapter-eyebrow {
		color: rgb(var(--color-muted));
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.01em;
	}

	.chapter-points {
		display: grid;
		gap: 0.875rem;
		margin: 1.75rem 0 0;
		padding: 0;
		list-style: none;
	}

	.chapter-points li {
		display: grid;
		grid-template-columns: 1.25rem 1fr;
		gap: 0.75rem;
		align-items: start;
		color: rgb(var(--color-muted));
		font-size: 0.9375rem;
		line-height: 1.55;
	}

	.chapter-points svg {
		width: 1.25rem;
		height: 1.25rem;
		margin-top: 0.125rem;
		padding: 0.1875rem;
		border-radius: 50%;
		background: rgb(var(--accent-soft));
		fill: none;
		stroke: rgb(var(--accent-ink));
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	.chapter-points strong {
		display: block;
		color: rgb(var(--color-ink));
		font-weight: 600;
	}

	.chapter-cta {
		margin-top: 1.5rem;
	}

	/* ---- Visual ---- */

	.chapter-figure {
		position: relative;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-xxl);
		box-shadow: var(--shadow-panel);
	}

	.chapter-figure img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* A restrained accent wash so the two photographs read as one family
	   rather than as stock imagery. */
	.chapter-figure-tint {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			210deg,
			transparent 40%,
			rgb(var(--accent) / 26%) 100%
		);
		pointer-events: none;
	}

	:global([data-theme='dark']) .chapter-figure img {
		filter: brightness(0.82) saturate(0.9);
	}

	/* ---- Responsive ----
	   Default is the phone layout: one column, copy first, visual after. The
	   two-column split and the alternating direction only exist from 64rem. */

	@media (min-width: 64rem) {
		.chapter {
			grid-template-columns: 1fr 1fr;
			gap: clamp(3rem, 6vw, 5.5rem);
		}

		.chapter.is-reversed .chapter-copy {
			order: 2;
		}

		.chapter.is-reversed .chapter-visual {
			order: 1;
		}

		.chapter-figure {
			aspect-ratio: 1 / 1;
		}
	}
</style>
