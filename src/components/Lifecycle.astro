---
import RequestStage from './RequestStage.astro';
import { SectionId } from '../lib/constants';
import { LIFECYCLE } from '../lib/content';
---

{/*
 * How it works, told at the reader's own pace.
 *
 * This section used to be a five-dot rail above a 1280×680 film. The rail
 * spent a whole row on five words, and the film played on its own clock in a
 * frame that was mostly empty — so the two halves of the explanation never
 * met, and neither one held the eye.
 *
 * Now they are one thing. The steps scroll; the request card stays. Whichever
 * step is under the reader is the state the card is in, so the explanation and
 * the thing being explained can never fall out of step, and the reader
 * controls the pace. `stageController` does the mapping and nothing else.
 *
 * The stage sticks on every width. On a phone it pins to the top and the steps
 * pass beneath it, which is the layout most of this traffic actually sees.
 */}
<section class="section lifecycle" id={SectionId.HowItWorks} aria-labelledby="lifecycle-title" data-lifecycle>
	<div class="shell">
		<div class="lifecycle-head reveal">
			<p class="eyebrow">How it works</p>
			<h2 class="display-2" id="lifecycle-title">Five steps, and a clock on every one.</h2>
			<p class="lede">
				Nothing sits in limbo. Each stage has a deadline, and both sides can see exactly where the
				request stands.
			</p>
		</div>

		<div class="lifecycle-grid">
			<div class="lifecycle-stage">
				<RequestStage />
			</div>

			{/*
			 * The list stays a real ordered list, fully readable with no
			 * script and no scrolling: the active-step styling only ever
			 * changes emphasis, never visibility.
			 */}
			<ol class="lifecycle-steps">
				{
					LIFECYCLE.map((step) => (
						<li class="lifecycle-step" data-step={step.index}>
							<span class="lifecycle-index numeral" aria-hidden="true">
								{step.index}
							</span>
							<h3 class="lifecycle-title">{step.title}</h3>
							<p class="lifecycle-detail">{step.detail}</p>
							{step.timing && <span class="lifecycle-timing mono">{step.timing}</span>}
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<script>
	import { stageController } from '../lib/motion';

	const section = document.querySelector<HTMLElement>('[data-lifecycle]');
	if (section) stageController(section);
</script>

<style>
	.lifecycle {
		border-top: 1px solid rgb(var(--color-border));
		background:
			radial-gradient(70% 100% at 50% 0%, rgb(var(--color-primary) / 4%), transparent 72%),
			rgb(var(--color-canvas));
	}

	.lifecycle-head {
		max-width: 40rem;
	}

	.lifecycle-head .lede {
		max-width: 34rem;
	}

	.lifecycle-grid {
		display: grid;
		gap: clamp(1.75rem, 4vw, 2.5rem);
		margin-top: clamp(2.5rem, 5vw, 3.5rem);
	}

	/* ---- The stage ----
	   Sticky at both layouts. Below 64rem it pins under the header and the
	   steps pass beneath it; from 64rem it holds the right column. */

	.lifecycle-stage {
		position: sticky;
		z-index: 2;
		/* Exactly the header's height, so the opaque ground below picks up
		   where the header's own band leaves off and nothing shows in between. */
		top: 4.5rem;
		align-self: start;
	}

	/* ---- The steps ---- */

	.lifecycle-steps {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/*
	 * A step is tall enough that exactly one of them occupies the middle band
	 * of the viewport at a time — that band is what the controller reads. The
	 * left rule is the spine the whole column hangs from; the active step lights its
	 * own segment of it.
	 */
	.lifecycle-step {
		position: relative;
		display: grid;
		/* `start`, not the default stretch: a step with no timing pill has one
		   row fewer to fill the min-height with, and its rows would drift
		   apart from every other step's. */
		align-content: start;
		gap: 0.375rem;
		padding: 2rem 0 2rem 1.5rem;
		border-left: 1px solid rgb(var(--color-border));
	}

	.lifecycle-step::before {
		position: absolute;
		top: 2.35rem;
		left: -0.3125rem;
		width: 0.5625rem;
		height: 0.5625rem;
		border-radius: 50%;
		background: rgb(var(--color-border-strong));
		content: '';
		transition:
			background-color var(--dur-slow) var(--ease-out),
			box-shadow var(--dur-slow) var(--ease-out);
	}

	.lifecycle-step.is-active::before {
		background: rgb(var(--color-primary));
		box-shadow: 0 0 0 0.3125rem rgb(var(--color-primary) / 16%);
	}

	:global([data-theme='dark']) .lifecycle-step.is-active::before {
		background: rgb(var(--color-primary-strong));
		box-shadow: 0 0 0 0.3125rem rgb(var(--color-primary-strong) / 18%);
	}

	.lifecycle-index {
		color: rgb(var(--color-muted) / 55%);
		font-size: 1.5rem;
		transition: color var(--dur-slow) var(--ease-out);
	}

	.lifecycle-step.is-active .lifecycle-index {
		color: rgb(var(--color-primary));
	}

	:global([data-theme='dark']) .lifecycle-step.is-active .lifecycle-index {
		color: rgb(var(--color-primary-strong));
	}

	.lifecycle-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2.1vw, 1.875rem);
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.15;
	}

	.lifecycle-detail {
		margin: 0;
		max-width: 30rem;
		color: rgb(var(--color-muted));
		font-size: 1rem;
		line-height: 1.6;
	}

	.lifecycle-timing {
		justify-self: start;
		margin-top: 0.5rem;
		padding: 0.3125rem 0.625rem;
		border: 1px solid rgb(var(--color-primary) / 24%);
		border-radius: var(--radius-pill);
		background: rgb(var(--color-primary-soft));
		color: rgb(var(--color-primary-strong));
		font-weight: 600;
	}

	/*
	 * Emphasis, never visibility. A step the reader has not reached is dimmed
	 * to the point of being clearly secondary and no further — the whole list
	 * stays readable if the script never runs, and stays selectable and
	 * searchable either way.
	 */
	@media (prefers-reduced-motion: no-preference) {
		.js .lifecycle-step {
			opacity: 0.42;
			transition: opacity var(--dur-slow) var(--ease-out);
		}

		.js .lifecycle-step.is-active {
			opacity: 1;
		}
	}

	/* ---- Responsive ---- */

	@media (max-width: 63.999rem) {
		/*
		 * Pinned at the top of a phone, the card has the steps travelling
		 * directly behind it — and glass is transparent, so two paragraphs
		 * read through each other. The column gets an opaque ground that
		 * fades out at the card's lower edge, so a step dissolves under the
		 * card rather than showing through it. The card itself stays glass.
		 */
		.lifecycle-stage {
			padding-block: 0.75rem 1.75rem;
			/* The step markers hang a few pixels outside the shell, so the
			   ground has to reach past it or a dot shows beside the card. */
			margin-inline: -0.75rem;
			padding-inline: 0.75rem;
			/* Solid everywhere the card actually is; the fade is the padding
			   below it, stated as a length so it cannot creep up over the
			   card as the card's own height changes. */
			background: linear-gradient(
				to bottom,
				rgb(var(--color-canvas)) 0,
				rgb(var(--color-canvas)) calc(100% - 1.75rem),
				rgb(var(--color-canvas) / 0%) 100%
			);
		}

		.lifecycle-step {
			padding-block: 1.5rem;
		}

		.lifecycle-step::before {
			top: 1.85rem;
		}
	}

	@media (min-width: 64rem) {
		.lifecycle-grid {
			align-items: start;
			gap: clamp(2.5rem, 6vw, 5rem);
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}

		/* Source order puts the stage first so it pins correctly on a phone;
		   at this width it moves to the right column, where the eye lands
		   after reading the step beside it. */
		.lifecycle-stage {
			top: 7.5rem;
			order: 2;
		}

		.lifecycle-steps {
			order: 1;
		}

		.lifecycle-step {
			padding-block: 3.25rem;
			/* One step, one middle band. Anything shorter lets two steps share
			   the band and the card flickers between them. */
			min-height: 20rem;
		}

		.lifecycle-step:first-child {
			padding-top: 0.5rem;
		}

		.lifecycle-step::before {
			top: 3.6rem;
		}

		.lifecycle-step:first-child::before {
			top: 0.85rem;
		}
	}

	/* Sticky positioning plus a reader who has asked for less movement is a bad
	   pairing: the card would still travel the whole section. It becomes a
	   plain block above the list, showing the final state. */
	@media (prefers-reduced-motion: reduce) {
		.lifecycle-stage {
			position: static;
			max-height: none;
			margin-bottom: 2rem;
		}
	}
</style>
