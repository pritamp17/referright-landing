---
import { siAtlassian, siFigma, siNetflix, siStripe } from 'simple-icons';
import { PEER_SIGNALS } from '../lib/content';

/*
 * Peer openings, as the reader would actually meet them.
 *
 * This replaces a film of a mocked Gmail inbox, most of which was an empty
 * reading pane. What matters about a peer opening is not the mail client it
 * arrives in — it is that the role reaches you while the window is still open,
 * so the cards carry a role, an employer and how long ago it appeared, and one
 * of them is always fresh.
 *
 * Three cards are on screen; five rotate through them, so the stack is never
 * the same twice and never still for long. `card-cycle.ts` does the rotation —
 * the same code the hero's proof cards use.
 */

interface SignalIcon {
	readonly path: string;
	readonly hex: string;
}

/*
 * Microsoft has no single-colour Simple Icons mark (their brand guidelines
 * forbid recolouring the four squares), so it is drawn here as the four
 * squares it is, and the chip below leaves it its own colours.
 */
const MICROSOFT_SQUARES = true;

const ICONS: Readonly<Record<string, SignalIcon | null>> = {
	Microsoft: null,
	Atlassian: siAtlassian,
	Figma: siFigma,
	Stripe: siStripe,
	Netflix: siNetflix,
};

const pool = PEER_SIGNALS.map((signal) => ({
	...signal,
	icon: ICONS[signal.company]?.path ?? null,
	hex: ICONS[signal.company]?.hex ?? null,
}));

const visible = pool.slice(0, 3);
---

<div class="signal-stack" data-signal-stack data-motion="signals" data-motion-state="paused">
	{/* The first card is the live one, so the ping belongs behind it. */}
	<span class="signal-sonar" aria-hidden="true">
		<i></i><i></i><i></i>
	</span>

	{
		visible.map((signal, index) => (
			<article class="signal-card glass" data-signal-slot data-cycle-index={index}>
				<span class="signal-logo" data-signal-logo aria-hidden="true">
					{signal.icon ? (
						<svg viewBox="0 0 24 24" style={`--logo: #${signal.hex};`}>
							<path d={signal.icon} />
						</svg>
					) : (
						MICROSOFT_SQUARES && (
							<svg viewBox="0 0 24 24" class="is-squares">
								<rect x="2" y="2" width="9" height="9" fill="#F25022" />
								<rect x="13" y="2" width="9" height="9" fill="#7FBA00" />
								<rect x="2" y="13" width="9" height="9" fill="#00A4EF" />
								<rect x="13" y="13" width="9" height="9" fill="#FFB900" />
							</svg>
						)
					)}
				</span>

				<span class="signal-body">
					<strong data-signal-role>{signal.role}</strong>
					<small data-signal-meta>{signal.company} · {signal.location}</small>
				</span>

				<span class="signal-time mono" data-signal-posted>{signal.posted}</span>

				<span class="signal-path" data-signal-path>
					<i aria-hidden="true"></i>
					{signal.path}
				</span>
			</article>
		))
	}
</div>

{/* Built at compile time so `simple-icons` never reaches the browser. */}
<script type="application/json" data-signal-pool set:html={JSON.stringify(pool)} />

<script>
	import { startCardCycle } from '../lib/card-cycle';
	import { motionGate } from '../lib/motion';

	interface PooledSignal {
		readonly role: string;
		readonly company: string;
		readonly location: string;
		readonly posted: string;
		readonly path: string;
		readonly icon: string | null;
		readonly hex: string | null;
	}

	const stack = document.querySelector<HTMLElement>('[data-signal-stack]');
	const poolNode = document.querySelector<HTMLScriptElement>('[data-signal-pool]');

	if (stack && poolNode) {
		motionGate(stack, 0.2);

		const pool: readonly PooledSignal[] = JSON.parse(poolNode.textContent ?? '[]');
		const slots = Array.from(stack.querySelectorAll<HTMLElement>('[data-signal-slot]'));

		startCardCycle<PooledSignal>({
			stack,
			slots,
			pool,
			transitionMs: 460,
			cycleMs: 3800,
			render: (slot, signal) => {
				const role = slot.querySelector<HTMLElement>('[data-signal-role]');
				const meta = slot.querySelector<HTMLElement>('[data-signal-meta]');
				const posted = slot.querySelector<HTMLElement>('[data-signal-posted]');
				const logo = slot.querySelector<HTMLElement>('[data-signal-logo]');

				if (role) role.textContent = signal.role;
				if (meta) meta.textContent = `${signal.company} · ${signal.location}`;
				if (posted) posted.textContent = signal.posted;
				if (!logo) return;

				/* The mark is the only part that is not text. Simple Icons ships
				   one path per brand; Microsoft is its own four squares. */
				logo.innerHTML = signal.icon
					? `<svg viewBox="0 0 24 24" style="--logo: #${signal.hex}"><path d="${signal.icon}"></path></svg>`
					: '<svg viewBox="0 0 24 24" class="is-squares">' +
						'<rect x="2" y="2" width="9" height="9" fill="#F25022"></rect>' +
						'<rect x="13" y="2" width="9" height="9" fill="#7FBA00"></rect>' +
						'<rect x="2" y="13" width="9" height="9" fill="#00A4EF"></rect>' +
						'<rect x="13" y="13" width="9" height="9" fill="#FFB900"></rect>' +
						'</svg>';
			},
		});
	}
</script>

<style>
	.signal-stack {
		position: relative;
		display: grid;
		gap: 0.75rem;
		isolation: isolate;
	}

	/* ---- The ping ----
	   Three rings breathing outward behind the freshest card. It is the
	   product's own loader motif, which is what "something just arrived"
	   already looks like inside the app. */

	.signal-sonar {
		position: absolute;
		z-index: -1;
		top: 2.25rem;
		left: 2.25rem;
		width: 0;
		height: 0;
		pointer-events: none;
	}

	.signal-sonar i {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 4rem;
		height: 4rem;
		border: 1px solid rgb(var(--color-sonar) / 45%);
		border-radius: 50%;
		opacity: 0;
		transform: translate(-50%, -50%) scale(0.4);
	}

	/* ---- Cards ---- */

	.signal-card {
		display: grid;
		align-items: center;
		gap: 0.25rem 0.875rem;
		padding: 0.9375rem 1.0625rem;
		grid-template-columns: auto minmax(0, 1fr) auto;
		transition:
			opacity 460ms var(--ease-out),
			transform 460ms var(--ease-out),
			filter 460ms var(--ease-out);
	}

	/*
	 * Only the top card is live; the two behind it are recent history and step
	 * back accordingly. Scale rather than colour does the recession, so it
	 * survives both themes without a second set of values.
	 */
	.signal-card:nth-child(3) {
		transform: scale(0.975);
		opacity: 0.82;
	}

	.signal-card:nth-child(4) {
		transform: scale(0.95);
		opacity: 0.62;
	}

	.signal-logo {
		display: grid;
		width: 2.375rem;
		height: 2.375rem;
		border: 1px solid rgb(var(--color-border) / 70%);
		border-radius: var(--radius-sm);
		background: rgb(var(--color-surface));
		grid-row: span 2;
		place-items: center;
	}

	.signal-logo svg {
		width: 1.125rem;
		height: 1.125rem;
		fill: var(--logo, rgb(var(--color-ink)));
	}

	.signal-logo svg.is-squares {
		width: 1.0625rem;
		height: 1.0625rem;
	}

	.signal-body {
		display: grid;
		min-width: 0;
		gap: 0.0625rem;
	}

	.signal-body strong {
		overflow: hidden;
		font-size: 0.9375rem;
		font-weight: 650;
		letter-spacing: -0.01em;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.signal-body small {
		color: rgb(var(--color-muted));
		font-size: 0.8125rem;
	}

	.signal-time {
		align-self: start;
		color: rgb(var(--color-muted));
		white-space: nowrap;
	}

	.signal-path {
		display: inline-flex;
		align-items: center;
		gap: 0.4375rem;
		grid-column: 2 / -1;
		margin-top: 0.375rem;
		color: rgb(var(--color-progress-ink));
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.signal-path i {
		width: 0.4375rem;
		height: 0.4375rem;
		border-radius: 50%;
		background: rgb(var(--color-progress));
		box-shadow: 0 0 0 0.1875rem rgb(var(--color-progress) / 18%);
	}

	/* ---- Motion ---- */

	@media (prefers-reduced-motion: no-preference) {
		.signal-stack .signal-card {
			opacity: 0;
			filter: blur(5px);
		}

		.signal-stack.is-ready .signal-card {
			opacity: 1;
			filter: none;
		}

		.signal-stack.is-ready .signal-card:nth-child(3) {
			opacity: 0.82;
		}

		.signal-stack.is-ready .signal-card:nth-child(4) {
			opacity: 0.62;
		}

		/* A swapping card leaves upward and its replacement arrives from
		   below, so the stack reads as a feed rather than a shuffle. */
		.signal-stack.is-ready .signal-card.is-exiting,
		.signal-stack.is-ready .signal-card.is-entering {
			opacity: 0;
			filter: blur(5px);
		}

		.signal-stack.is-ready .signal-card.is-exiting {
			transform: translateY(-0.375rem) scale(0.985);
		}

		.signal-stack.is-ready .signal-card.is-entering {
			transform: translateY(0.5rem) scale(0.985);
		}

		.signal-stack[data-motion-state='playing'] .signal-sonar i {
			animation: sonar 2400ms var(--ease-out) infinite backwards;
		}

		.signal-sonar i:nth-child(2) {
			animation-delay: 800ms;
		}

		.signal-sonar i:nth-child(3) {
			animation-delay: 1600ms;
		}

		@keyframes sonar {
			0% {
				opacity: 0.85;
				transform: translate(-50%, -50%) scale(0.35);
			}
			100% {
				opacity: 0;
				transform: translate(-50%, -50%) scale(2.4);
			}
		}
	}

	/* Two lines beat an ellipsis: "Senior Backend E..." tells the reader less
	   than the role does. */
	@media (max-width: 30rem) {
		.signal-body strong {
			overflow: visible;
			text-overflow: clip;
			white-space: normal;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.signal-sonar i:first-child {
			opacity: 0.35;
			transform: translate(-50%, -50%) scale(1.1);
		}
	}
</style>
