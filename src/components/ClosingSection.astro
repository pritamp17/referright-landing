---
import Brand from './Brand.astro';
import DoorWall from './DoorWall.astro';
import ThemeToggle from './ThemeToggle.astro';
import { OUTCOME_DISCLAIMER, SectionId, SignUpIntent, TrackEvent } from '../lib/constants';
import { CONTACT_EMAIL, PRIVACY_URL, TERMS_URL, signUpWith } from '../lib/content';

const year = new Date().getFullYear();

/*
 * The bookend.
 *
 * The page opens on a wall of closed doors with one of them opening from the
 * inside, and it ends on the same wall — mirrored, dimmed, and with the light
 * already on. That is the argument closing: the first screen asks you to
 * believe somebody inside will open it, and by this point the page has spent
 * eight sections showing how.
 *
 * The primary call to action does not change appearance here, which is why the
 * section is not a deep blue panel: it was one once, and a blue panel forces a
 * blue-on-blue button to restyle itself, so the page's single most important
 * control looked like two different controls depending where you met it.
 */
const headline: readonly string[] = ['Somebody', 'inside', 'is', 'willing', 'to', 'help.'];

const productLinks = [
	{ label: 'How it works', href: `#${SectionId.HowItWorks}` },
	{ label: 'Reviews', href: `#${SectionId.Stories}` },
	{ label: 'Questions', href: `#${SectionId.Faq}` },
] as const;

const policyLinks = [
	PRIVACY_URL ? { label: 'Privacy', href: PRIVACY_URL } : null,
	TERMS_URL ? { label: 'Terms', href: TERMS_URL } : null,
].filter((link): link is { label: string; href: string } => link !== null);
---

<section class="closing" id={SectionId.Contact} aria-labelledby="closing-title" data-closing>
	{/* The wall is bounded to this block so the doorway lands behind the
	    headline and the call to action, not behind the footer. */}
	<div class="closing-stage">
		<DoorWall variant="bookend" class="closing-wall" />
		<div class="grid-texture" aria-hidden="true"></div>

		<div class="shell closing-inner reveal">
			<h2 class="display-2 closing-title" id="closing-title">
				{headline.map((word, index) => <span style={`--w: ${index};`}>{word}</span>)}
			</h2>

			<p class="closing-lede">Tell us the role. We will find them.</p>

			<a
				class="button button-primary button-lg"
				href={signUpWith(SignUpIntent.Seeker)}
				data-track={TrackEvent.ClosingPrimary}
			>
				<span>Ask for a referral</span>
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
				</svg>
			</a>

			<p class="fine-print closing-disclaimer">{OUTCOME_DISCLAIMER}</p>
		</div>
	</div>

	<footer class="site-footer">
		<div class="shell footer-grid">
			<div class="footer-brand">
				<Brand size="sm" />
				<p>Professional introductions between people who already work where you want to.</p>
			</div>

			<nav class="footer-nav" aria-label="Sections">
				<p class="footer-heading mono">Product</p>
				<ul>
					{productLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
				</ul>
			</nav>

			<div class="footer-nav">
				<p class="footer-heading mono">Company</p>
				<ul>
					<li>
						<a href={`mailto:${CONTACT_EMAIL}`} data-track={TrackEvent.ContactEmail}>Support</a>
					</li>
					{policyLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
				</ul>
			</div>
		</div>

		<div class="shell footer-base">
			<p class="footer-note">© {year} RightRefer. Professional introductions, handled carefully.</p>
			<span class="footer-region mono">India</span>
			<ThemeToggle />
		</div>
	</footer>
</section>

<script>
	/* The doorway light comes up as the section is reached, rather than on
	   load — the page ends on it, so it should arrive with the reader. */
	const closing = document.querySelector<HTMLElement>('[data-closing]');

	if (closing) {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
			closing.classList.add('is-lit');
		} else {
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						closing.classList.add('is-lit');
						observer.disconnect();
					}
				},
				{ threshold: 0.2 },
			);
			observer.observe(closing);
		}
	}
</script>

<style>
	.closing {
		position: relative;
		overflow: hidden;
		border-top: 1px solid rgb(var(--color-border));
		isolation: isolate;
	}

	.closing-stage {
		position: relative;
		overflow: hidden;
		isolation: isolate;
	}

	.closing-stage :global(.closing-wall) {
		z-index: 0;
	}

	.closing-inner {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		padding-block: clamp(5.5rem, 11vw, 10rem);
		text-align: center;
	}

	/* The one place on the page where display type gets hero scale outside the
	   hero. It is answering the hero, so it is set at the hero's size. */
	.closing-title {
		max-width: 20ch;
		font-size: clamp(2.5rem, 5vw, 4rem);
		line-height: 1.04;
		letter-spacing: -0.04em;
	}

	.closing-title span {
		display: inline-block;
		/* The words are inline-block so each can be transformed on its own,
		   which means the whitespace between them no longer renders. */
		margin-right: 0.26em;
	}

	.closing-title span:last-child {
		margin-right: 0;
	}

	.closing-lede {
		max-width: 30rem;
		margin: 1.25rem 0 2.25rem;
		color: rgb(var(--color-muted));
		font-size: 1.125rem;
		line-height: 1.6;
	}

	.closing-disclaimer {
		margin-top: 1.25rem;
	}

	/* ---- Footer ---- */

	.site-footer {
		position: relative;
		z-index: 1;
		border-top: 1px solid rgb(var(--color-border));
		background: rgb(var(--color-surface) / 60%);
	}

	.footer-grid {
		display: grid;
		gap: 2.25rem;
		padding-block: clamp(2.5rem, 5vw, 3.5rem) 2rem;
	}

	.footer-brand p {
		max-width: 22rem;
		margin: 0.875rem 0 0;
		color: rgb(var(--color-muted));
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.footer-heading {
		margin: 0;
		color: rgb(var(--color-muted) / 75%);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.footer-nav ul {
		display: grid;
		gap: 0.125rem;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	/* Padding rather than height alone: the shortest label here is 36px wide.
	   The negative margin keeps the text aligned with the column heading, so
	   the target grows without the column looking indented. */
	.footer-nav a {
		display: inline-flex;
		min-width: 2.75rem;
		min-height: 2.75rem;
		align-items: center;
		margin-inline: -0.5rem;
		padding-inline: 0.5rem;
		border-radius: var(--radius-sm);
		color: rgb(var(--color-muted));
		font-size: 0.9375rem;
		transition: color var(--dur-fast) ease;
	}

	.footer-nav a:hover {
		color: rgb(var(--color-ink));
	}

	/* ---- Base row ---- */

	.footer-base {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.25rem;
		padding-block: 1.125rem;
		border-top: 1px solid rgb(var(--color-border) / 70%);
	}

	.footer-note {
		margin: 0;
		color: rgb(var(--color-muted));
		font-size: 0.8125rem;
	}

	.footer-region {
		margin-inline-start: auto;
		padding: 0.25rem 0.625rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-pill);
		color: rgb(var(--color-muted) / 85%);
	}

	/* ---- Responsive ---- */

	@media (min-width: 48rem) {
		.footer-grid {
			gap: 3rem;
			grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
		}
	}

	/* ---- Motion ---- */

	@media (prefers-reduced-motion: no-preference) {
		.js .closing-title span {
			opacity: 0;
			transform: translateY(0.75rem);
			transition:
				opacity 720ms var(--ease-out),
				transform 720ms var(--ease-out);
			transition-delay: calc(var(--w, 0) * 70ms);
		}

		.js .closing-inner.is-visible .closing-title span {
			opacity: 1;
			transform: none;
		}
	}
</style>
