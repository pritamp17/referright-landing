---
import Brand from './Brand.astro';
import { OUTCOME_DISCLAIMER, SectionId, SignUpIntent, TrackEvent } from '../lib/constants';
import { CONTACT_EMAIL, signUpWith } from '../lib/content';

const year = new Date().getFullYear();
---

<section class="closing" id={SectionId.Contact} aria-labelledby="closing-title">
	<div class="grid-texture" aria-hidden="true"></div>

	<div class="shell closing-inner reveal">
		<h2 class="display-2" id="closing-title">Somebody inside is willing to help.</h2>
		<p class="closing-lede">Tell us the role. We will find them.</p>

		<a
			class="button button-on-brand button-lg"
			href={signUpWith(SignUpIntent.Seeker)}
			data-track={TrackEvent.ClosingPrimary}
		>
			<span>Ask for a referral</span>
			<svg viewBox="0 0 16 16" aria-hidden="true">
				<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
			</svg>
		</a>

		<p class="fine-print closing-disclaimer">{OUTCOME_DISCLAIMER}</p>
	</div>

	<footer class="site-footer">
		<div class="shell footer-inner">
			<Brand size="sm" onBrandSurface />

			<p class="footer-note">© {year} RightRefer. Professional introductions, handled carefully.</p>

			<div class="footer-support">
				<span class="footer-support-label">Support</span>
				<a class="footer-mail" href={`mailto:${CONTACT_EMAIL}`} data-track={TrackEvent.ContactEmail}>
					{CONTACT_EMAIL}
				</a>
			</div>
		</div>
	</footer>
</section>

<style>
	/*
	 * The page's ending, and its only inverted surface.
	 *
	 * `--color-brand-panel` exists in tokens.css precisely for this and stays
	 * blue in BOTH themes, so the closing note never washes out in dark mode.
	 * Until now the page simply stopped on the same cream it opened with, which
	 * read as running out rather than concluding.
	 */
	.closing {
		position: relative;
		overflow: hidden;
		background: rgb(var(--color-brand-panel));
		color: rgb(var(--color-brand-panel-ink));
		isolation: isolate;
	}

	/* The shared texture is drawn from the ink token, which is near-black in
	   light mode and therefore invisible on this panel. Re-draw it in the
	   panel's own foreground instead. */
	.closing .grid-texture {
		background-image:
			linear-gradient(rgb(var(--color-brand-panel-ink) / 7%) 1px, transparent 1px),
			linear-gradient(90deg, rgb(var(--color-brand-panel-ink) / 7%) 1px, transparent 1px);
	}

	.closing-inner {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		padding-block: clamp(4.5rem, 9vw, 8rem);
		text-align: center;
	}

	.closing-lede {
		max-width: 30rem;
		margin: 1rem 0 2rem;
		color: rgb(var(--color-brand-panel-ink) / 78%);
		font-size: 1.125rem;
		line-height: 1.6;
	}

	.closing-disclaimer {
		margin-top: 1.25rem;
		color: rgb(var(--color-brand-panel-ink) / 68%);
	}

	/*
	 * The primary button is brand blue, which would be blue-on-blue here. On an
	 * inverted panel the panel's own foreground becomes the fill and the panel
	 * colour becomes the label — the highest-contrast pairing available without
	 * introducing a colour.
	 */
	.button-on-brand {
		background: rgb(var(--color-brand-panel-ink));
		box-shadow: 0 0.75rem 1.75rem rgb(0 0 0 / 22%);
		color: rgb(var(--color-brand-panel));
	}

	.button-on-brand:hover {
		background: rgb(var(--color-brand-panel-ink) / 90%);
		box-shadow: 0 1rem 2.25rem rgb(0 0 0 / 30%);
		transform: translateY(-1px);
	}

	.button-on-brand:focus-visible {
		outline-color: rgb(var(--color-brand-panel-ink));
	}

	/* ---- Footer ---- */

	.site-footer {
		position: relative;
		z-index: 1;
		border-top: 1px solid rgb(var(--color-brand-panel-ink) / 16%);
		background: rgb(0 0 0 / 14%);
	}

	.footer-inner {
		display: grid;
		gap: 1rem;
		justify-items: center;
		padding-block: 1.75rem;
		text-align: center;
	}

	.footer-note {
		margin: 0;
		color: rgb(var(--color-brand-panel-ink) / 68%);
		font-size: 0.8125rem;
	}

	.footer-support {
		display: grid;
		justify-items: center;
		gap: 0.125rem;
	}

	.footer-support-label {
		color: rgb(var(--color-brand-panel-ink) / 60%);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.footer-mail {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		color: rgb(var(--color-brand-panel-ink));
		font-size: 0.875rem;
		font-weight: 600;
	}

	@media (min-width: 48rem) {
		.footer-inner {
			grid-template-columns: auto 1fr auto;
			align-items: center;
			justify-items: start;
			text-align: left;
		}

		.footer-note {
			justify-self: center;
		}

		.footer-support {
			justify-items: end;
		}
	}
</style>
