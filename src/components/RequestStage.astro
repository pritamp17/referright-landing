---
import { LIFECYCLE } from '../lib/content';

/*
 * One referral request, told as five states of a single card.
 *
 * This replaces a 1280×680 film that was mostly empty bezel. Everything here
 * is ordinary DOM painted from tokens, so it re-themes with the page, stays
 * sharp at any zoom, weighs nothing, and — the reason it exists — is driven by
 * the reader's own scroll rather than a clock they cannot see.
 *
 * The component itself is stateless. `stageController` in `lib/motion.ts`
 * writes `data-active-step` from whichever step is under the reader, and every
 * transition below keys off that one attribute. Anything marked `data-for`
 * belongs to exactly one step; the rest of the card is permanent, so the
 * reader's eye stays on the same object while its state changes underneath.
 *
 * The colour of a state is not decided here twice: it follows the product's
 * own lifecycle presentation (PRD §8.13) — open is primary, work in someone
 * else's hands is `progress`, something waiting on you is `warning`, done is
 * `success` — and it is expressed as a rail rather than a fill, which is the
 * product's rule for exactly this reason.
 */

const [ask, claim, refer, confirm, thanks] = LIFECYCLE;
---

<article class="stage glass" data-stage data-active-step="01" aria-hidden="true">
	<span class="stage-rail"></span>

	<header class="stage-head">
		<span class="stage-role">
			<strong>Product Manager</strong>
			<small>Microsoft · Bengaluru</small>
		</span>

		<span class="stage-status">
			<span data-for="01">Request sent</span>
			<span data-for="02">Claimed</span>
			<span data-for="03">Referral sent</span>
			<span data-for="04">Needs you</span>
			<span data-for="05">Complete</span>
		</span>
	</header>

	<div class="stage-body">
		{/* 01 — the request is assembled and goes out. */}
		<div class="stage-layer" data-for="01">
			<ul class="stage-chips">
				<li>
					<svg viewBox="0 0 16 16"><path d="M4 2h5l3 3v9H4z" /><path d="M9 2v3h3" /></svg>
					Resume attached
				</li>
				<li>
					<svg viewBox="0 0 16 16"><path d="M3 3h10v7H8l-3 3v-3H3z" /></svg>
					Context added
				</li>
			</ul>
			<p class="stage-note">Visible only to employees whose jobs at Microsoft are verified.</p>
		</div>

		{/* 02 — verified employees see it; exactly one takes it on. */}
		<div class="stage-layer" data-for="02">
			<ul class="stage-people">
				<li><span aria-hidden="true"></span></li>
				<li class="is-claimer">
					<span aria-hidden="true">
						<svg viewBox="0 0 16 16"><path d="M3.4 8.4l3 3 6.2-7" /></svg>
					</span>
				</li>
				<li><span aria-hidden="true"></span></li>
			</ul>
			<p class="stage-note">One verified employee has taken it on. Nobody else can claim it now.</p>
		</div>

		{/* 03 — the proof, which is the whole trust argument in one object. */}
		<div class="stage-layer" data-for="03">
			<div class="stage-proof">
				<span class="stage-proof-shot" aria-hidden="true">
					<i></i><i></i><i></i>
				</span>
				<span class="stage-proof-stamp mono" aria-hidden="true">14:32</span>
			</div>
			<p class="stage-note">Submitted inside Microsoft's own system, with a timestamped screenshot.</p>
		</div>

		{/* 04 — the one step that is genuinely the reader's move. */}
		<div class="stage-layer" data-for="04">
			<div class="stage-choice">
				<span class="stage-choice-primary">Confirm</span>
				<span class="stage-choice-ghost">Dispute</span>
			</div>
			<p class="stage-note">Check the proof. A dispute is read by a person, never closed automatically.</p>
		</div>

		{/* 05 — optional, and said as such. */}
		<div class="stage-layer" data-for="05">
			<span class="stage-thanks">
				<svg viewBox="0 0 16 16"><path d="M3 6h8v4a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3z" /><path d="M11 7h1.5a1.5 1.5 0 0 1 0 3H11" /></svg>
				Send thanks
				<em>optional</em>
			</span>
			<p class="stage-note">Referred, confirmed, and closed. A thank-you changes none of that.</p>
		</div>
	</div>

	<footer class="stage-foot">
		<span class="stage-clock" aria-hidden="true">
			<svg viewBox="0 0 44 44">
				<circle class="stage-clock-track" cx="22" cy="22" r="18"></circle>
				<circle class="stage-clock-arc" cx="22" cy="22" r="18"></circle>
			</svg>
		</span>

		<span class="stage-timing mono">
			<span data-for="01">live now</span>
			<span data-for="02">{claim.timing}</span>
			<span data-for="03">{refer.timing}</span>
			<span data-for="04">{confirm.timing}</span>
			<span data-for="05">{thanks.timing}</span>
		</span>

		<span class="stage-step mono" aria-hidden="true">
			<span data-for="01">{ask.index}</span>
			<span data-for="02">{claim.index}</span>
			<span data-for="03">{refer.index}</span>
			<span data-for="04">{confirm.index}</span>
			<span data-for="05">{thanks.index}</span>
			<i>/ 05</i>
		</span>
	</footer>
</article>

<style>
	/* ---- State map ----
	   One state, one presentation: the accent below drives the rail, the status
	   pill, the clock arc and every accented element inside the layer. */

	.stage {
		--stage-accent: var(--color-primary);
		--stage-accent-soft: var(--color-primary-soft);
		--stage-accent-ink: var(--color-primary-strong);
		--ring: 0.08;
	}

	.stage[data-active-step='02'],
	.stage[data-active-step='03'] {
		--stage-accent: var(--color-progress);
		--stage-accent-soft: var(--color-progress-soft);
		--stage-accent-ink: var(--color-progress-ink);
	}

	.stage[data-active-step='02'] {
		--ring: 0.34;
	}

	.stage[data-active-step='03'] {
		--ring: 0.58;
	}

	.stage[data-active-step='04'] {
		--stage-accent: var(--color-warning);
		--stage-accent-soft: var(--color-warning-soft);
		--stage-accent-ink: var(--color-warning-ink);
		--ring: 0.82;
	}

	.stage[data-active-step='05'] {
		--stage-accent: var(--color-success);
		--stage-accent-soft: var(--color-success-soft);
		--stage-accent-ink: var(--color-success-ink);
		--ring: 1;
	}

	/* ---- Card ---- */

	.stage {
		position: relative;
		display: grid;
		overflow: hidden;
		gap: 1.25rem;
		padding: clamp(1.5rem, 2.6vw, 1.875rem);
		border-radius: var(--radius-lg);
		grid-template-rows: auto 1fr auto;
	}

	/* State is a rail, not a fill — the product's own rule, so the marketing
	   page and the signed-in product speak the same visual language. */
	.stage-rail {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 3px;
		background: rgb(var(--stage-accent));
		transition: background-color var(--dur-slow) var(--ease-out);
	}

	/* ---- Head ---- */

	.stage-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.stage-role {
		display: grid;
		gap: 0.125rem;
		min-width: 0;
	}

	.stage-role strong {
		font-size: 1.0625rem;
		font-weight: 650;
		letter-spacing: -0.015em;
	}

	.stage-role small {
		color: rgb(var(--color-muted));
		font-size: 0.8125rem;
	}

	.stage-status {
		display: grid;
		flex: 0 0 auto;
		padding: 0.375rem 0.75rem;
		border: 1px solid rgb(var(--stage-accent) / 30%);
		border-radius: var(--radius-pill);
		background: rgb(var(--stage-accent-soft));
		color: rgb(var(--stage-accent-ink));
		font-size: 0.75rem;
		font-weight: 650;
		letter-spacing: -0.005em;
		white-space: nowrap;
		transition:
			background-color var(--dur-slow) var(--ease-out),
			border-color var(--dur-slow) var(--ease-out),
			color var(--dur-slow) var(--ease-out);
	}

	/* ---- Layer switching ----
	   Every `data-for` element shares one grid cell with its siblings, so the
	   card never changes height as the state changes. */

	.stage-status > *,
	.stage-timing > [data-for],
	.stage-step > [data-for] {
		grid-area: 1 / 1;
	}

	.stage-timing,
	.stage-step {
		display: grid;
		grid-auto-flow: column;
		align-items: center;
		justify-content: start;
		gap: 0.25rem;
	}

	.stage [data-for] {
		opacity: 0;
		transform: translateY(0.4375rem);
		transition:
			opacity 420ms var(--ease-out),
			transform 420ms var(--ease-out);
	}

	.stage[data-active-step='01'] [data-for='01'],
	.stage[data-active-step='02'] [data-for='02'],
	.stage[data-active-step='03'] [data-for='03'],
	.stage[data-active-step='04'] [data-for='04'],
	.stage[data-active-step='05'] [data-for='05'] {
		opacity: 1;
		transform: none;
	}

	/* ---- Body ---- */

	.stage-body {
		display: grid;
		align-items: center;
		min-height: 9.5rem;
	}

	.stage-layer {
		display: grid;
		gap: 1rem;
		align-content: center;
		grid-area: 1 / 1;
	}

	.stage-note {
		margin: 0;
		max-width: 26rem;
		color: rgb(var(--color-muted));
		font-size: 0.875rem;
		line-height: 1.5;
	}

	/* ---- 01: chips ---- */

	.stage-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stage-chips li {
		display: inline-flex;
		align-items: center;
		gap: 0.4375rem;
		padding: 0.4375rem 0.75rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-pill);
		background: rgb(var(--color-surface));
		font-size: 0.8125rem;
		font-weight: 550;
	}

	.stage-chips svg {
		width: 0.875rem;
		height: 0.875rem;
		fill: none;
		stroke: rgb(var(--stage-accent-ink));
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.4;
	}

	/* ---- 02: who saw it ---- */

	.stage-people {
		display: flex;
		gap: 0.625rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stage-people span {
		display: grid;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: 50%;
		background: rgb(var(--color-elevated));
		place-items: center;
	}

	.stage-people .is-claimer span {
		border-color: rgb(var(--stage-accent) / 45%);
		background: rgb(var(--stage-accent-soft));
		box-shadow: 0 0 0 0.3125rem rgb(var(--stage-accent) / 12%);
	}

	.stage-people svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: rgb(var(--stage-accent-ink));
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	/* ---- 03: the proof ---- */

	.stage-proof {
		position: relative;
		width: fit-content;
	}

	.stage-proof-shot {
		display: grid;
		width: 11rem;
		gap: 0.4375rem;
		padding: 0.875rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-sm);
		background: rgb(var(--color-elevated));
	}

	.stage-proof-shot i {
		height: 0.375rem;
		border-radius: var(--radius-pill);
		background: rgb(var(--color-ink) / 14%);
	}

	.stage-proof-shot i:first-child {
		width: 70%;
		background: rgb(var(--color-ink) / 26%);
	}

	.stage-proof-shot i:last-child {
		width: 45%;
	}

	/* The stamp lands rather than fades: proof arriving is the one beat in this
	   card that should feel like an event. */
	.stage-proof-stamp {
		position: absolute;
		right: -1.75rem;
		bottom: -0.625rem;
		padding: 0.3125rem 0.625rem;
		border: 1px solid rgb(var(--stage-accent) / 40%);
		border-radius: var(--radius-pill);
		background: rgb(var(--stage-accent-soft));
		color: rgb(var(--stage-accent-ink));
		font-weight: 650;
	}

	/* ---- 04: the decision ---- */

	.stage-choice {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
	}

	.stage-choice-primary,
	.stage-choice-ghost {
		display: inline-flex;
		min-height: 2.375rem;
		align-items: center;
		padding-inline: 1.125rem;
		border: 1px solid transparent;
		border-radius: var(--radius-pill);
		font-size: 0.875rem;
		font-weight: 650;
	}

	.stage-choice-primary {
		background: rgb(var(--color-primary));
		box-shadow: 0 0.5rem 1.25rem rgb(var(--color-primary) / 24%);
		color: rgb(var(--color-primary-ink));
	}

	.stage-choice-ghost {
		border-color: rgb(var(--color-border));
		background: rgb(var(--color-surface));
		color: rgb(var(--color-muted));
	}

	/* ---- 05: thanks ---- */

	.stage-thanks {
		display: inline-flex;
		width: fit-content;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.9375rem;
		border: 1px solid rgb(var(--color-reward) / 32%);
		border-radius: var(--radius-pill);
		background: rgb(var(--color-reward-soft));
		color: rgb(var(--color-reward-ink));
		font-size: 0.875rem;
		font-weight: 650;
	}

	.stage-thanks svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentcolor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.4;
	}

	.stage-thanks em {
		color: rgb(var(--color-reward-ink) / 72%);
		font-size: 0.75rem;
		font-style: normal;
		font-weight: 550;
	}

	/* ---- Foot ---- */

	.stage-foot {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding-top: 1rem;
		border-top: 1px solid rgb(var(--color-border) / 70%);
	}

	.stage-clock {
		display: block;
		width: 1.75rem;
		height: 1.75rem;
		flex: 0 0 auto;
	}

	.stage-clock svg {
		width: 100%;
		height: 100%;
		transform: rotate(-90deg);
	}

	.stage-clock circle {
		fill: none;
		stroke-width: 4;
	}

	.stage-clock-track {
		stroke: rgb(var(--color-border));
	}

	/* 2πr for r=18. The arc is the only thing on this card that reports a
	   number, so it is drawn rather than written. */
	.stage-clock-arc {
		stroke: rgb(var(--stage-accent));
		stroke-dasharray: 113.1;
		stroke-dashoffset: calc(113.1 * (1 - var(--ring)));
		stroke-linecap: round;
		transition:
			stroke-dashoffset 620ms var(--ease-out),
			stroke var(--dur-slow) var(--ease-out);
	}

	.stage-timing {
		color: rgb(var(--color-muted));
	}

	.stage-step {
		margin-left: auto;
		color: rgb(var(--color-muted) / 70%);
	}

	.stage-step i {
		font-style: normal;
	}

	@media (max-width: 63.999rem) {
		.stage {
			gap: 1rem;
			padding: 1.25rem;
		}

		.stage-body {
			min-height: 7.5rem;
		}

		.stage-note {
			font-size: 0.8125rem;
		}
	}

	/* With motion reduced the controller pins the final state; nothing here
	   should still be waiting on a transition. */
	@media (prefers-reduced-motion: reduce) {
		.stage [data-for] {
			transform: none;
		}
	}
</style>
