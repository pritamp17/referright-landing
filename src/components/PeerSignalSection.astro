---
import SignalStack from './SignalStack.astro';
import { SectionId, SignUpIntent, TrackEvent } from '../lib/constants';
import { signUpWith } from '../lib/content';

/*
 * Offering 03, shown rather than filmed.
 *
 * The copy holds the left column and the signals arrive on the right, which
 * is the first split on the page after the two sections above it — the page's
 * rhythm from here on alternates side to side rather than repeating one
 * centred column.
 *
 * The cadence control is not decoration: `OpportunityFrequency` is a real
 * field on the member, and showing its three values is what makes "you control
 * the frequency" a visible promise instead of a written one.
 */
const CADENCES: readonly string[] = ['Daily', 'Weekly', 'Highly relevant'];
---

<section class="section peer-signal" id={SectionId.PeerSignal} aria-labelledby="peer-signal-title">
	<div class="shell peer-signal-grid">
		<div class="peer-signal-copy reveal">
			<p class="eyebrow">Offering 03, in practice</p>
			<h2 class="display-2" id="peer-signal-title">
				The role reaches you while the door is still open.
			</h2>
			<p class="lede">
				Senior roles are often filled quietly, and only get posted once the internal search has
				failed. Peer openings tell you a relevant role exists while that window is still open.
			</p>

			<a
				class="button button-primary peer-signal-cta"
				href={signUpWith(SignUpIntent.Peer)}
				data-track={TrackEvent.OfferingPeer}
			>
				<span>Turn on peer openings</span>
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
				</svg>
			</a>

			<p class="fine-print peer-signal-note">
				You are shown the opening, never the identity of whoever asked about it.
			</p>
		</div>

		<div class="peer-signal-panel reveal">
			<SignalStack />

			<div class="cadence" role="group" aria-label="How often peer openings arrive">
				<span class="cadence-label mono">Arrives</span>
				<span class="cadence-options">
					{
						CADENCES.map((cadence, index) => (
							<span class:list={['cadence-option', index === 0 && 'is-selected']}>{cadence}</span>
						))
					}
				</span>
			</div>

			<p class="fine-print cadence-note">
				You choose the cadence, and you can turn peer openings off at any time.
			</p>
		</div>
	</div>
</section>

<style>
	.peer-signal {
		border-top: 1px solid rgb(var(--color-border));
	}

	.peer-signal-grid {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
		align-items: center;
	}

	.peer-signal-copy .lede {
		max-width: 30rem;
	}

	.peer-signal-cta {
		margin-top: 1.75rem;
	}

	.peer-signal-note {
		margin-top: 1rem;
		max-width: 26rem;
	}

	/* ---- Panel ---- */

	.peer-signal-panel {
		display: grid;
		gap: 1.25rem;
	}

	/* The three cadences the product actually stores, shown as the switch the
	   member gets rather than described in a sentence. */
	.cadence {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	.cadence-label {
		color: rgb(var(--color-muted) / 80%);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.cadence-options {
		display: inline-flex;
		padding: 0.1875rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-pill);
		background: rgb(var(--color-surface) / 70%);
	}

	.cadence-option {
		padding: 0.375rem 0.75rem;
		border-radius: var(--radius-pill);
		color: rgb(var(--color-muted));
		font-size: 0.8125rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.cadence-option.is-selected {
		background: rgb(var(--color-progress-soft));
		color: rgb(var(--color-progress-ink));
	}

	.cadence-note {
		max-width: 26rem;
	}

	/* ---- Responsive ---- */

	@media (min-width: 64rem) {
		.peer-signal-grid {
			gap: clamp(3rem, 7vw, 6rem);
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}
</style>
