---
import type { Accent } from '../lib/constants';

export interface Testimonial {
	readonly name: string;
	readonly role: string;
	readonly quote: string;
	readonly initials: string;
	readonly accent: Accent;
}

interface Props {
	batches: readonly (readonly Testimonial[])[];
}

const { batches } = Astro.props;
---

<div
	class="stage"
	data-motion="testimonials"
	data-motion-state="paused"
	aria-label="RightRefer community feedback"
>
	{
		batches.map((batch, batchIndex) => (
			<div class:list={['lane', batchIndex % 2 === 1 && 'is-reverse']}>
				<div class="track" data-testimonial-track>
					{[...batch, ...batch].map((testimonial, cardIndex) => (
						<article
							class:list={['quote-card', `accent-${testimonial.accent}`]}
							aria-hidden={cardIndex >= batch.length ? 'true' : undefined}
						>
							<div class="quote-person">
								<span class="quote-avatar" aria-hidden="true">
									{testimonial.initials}
								</span>
								<span class="quote-identity">
									<strong>{testimonial.name}</strong>
									<small>{testimonial.role}</small>
								</span>
							</div>
							<blockquote>“{testimonial.quote}”</blockquote>
						</article>
					))}
				</div>
			</div>
		))
	}
</div>

<script>
	/* The marquee only animates while it is on screen, and never for a visitor
	   who has asked for reduced motion. */
	const stage = document.querySelector<HTMLElement>('[data-motion="testimonials"]');

	if (stage && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					stage.dataset.motionState = entry.isIntersecting ? 'playing' : 'paused';
				}
			},
			{ threshold: 0.15 },
		);
		observer.observe(stage);
	}
</script>

<style>
	.stage {
		display: grid;
		gap: 0.75rem;
		overflow: hidden;
		/* Fade the ends so cards enter and leave rather than being cut off. */
		mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
	}

	.lane {
		overflow: hidden;
	}

	.track {
		display: flex;
		width: max-content;
		gap: 0.75rem;
		animation: drift-left 42s linear infinite;
		animation-play-state: paused;
		will-change: transform;
	}

	.lane.is-reverse .track {
		animation-name: drift-right;
	}

	.stage[data-motion-state='playing'] .track {
		animation-play-state: running;
	}

	.stage:hover .track,
	.stage:focus-within .track {
		animation-play-state: paused;
	}

	/* ---- Card ---- */

	.quote-card {
		display: grid;
		width: 20rem;
		gap: 0.75rem;
		align-content: start;
		padding: 1.125rem 1.25rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-2xl);
		background: rgb(var(--color-surface));
		box-shadow: var(--shadow-raised);
	}

	.quote-person {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
	}

	.quote-avatar {
		display: grid;
		width: 2rem;
		height: 2rem;
		flex: 0 0 auto;
		border-radius: 50%;
		background: rgb(var(--accent-soft));
		color: rgb(var(--accent-ink));
		font-size: 0.6875rem;
		font-weight: 700;
		place-items: center;
	}

	.quote-identity {
		display: grid;
		min-width: 0;
	}

	.quote-identity strong {
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.quote-identity small {
		overflow: hidden;
		color: rgb(var(--color-muted));
		font-size: 0.75rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	blockquote {
		margin: 0;
		color: rgb(var(--color-ink));
		font-family: var(--font-display);
		font-size: 1rem;
		letter-spacing: -0.015em;
		line-height: 1.35;
	}

	@keyframes drift-left {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(calc(-50% - 0.375rem));
		}
	}

	@keyframes drift-right {
		from {
			transform: translateX(calc(-50% - 0.375rem));
		}
		to {
			transform: translateX(0);
		}
	}

	@media (max-width: 30rem) {
		.quote-card {
			width: min(18rem, calc(100vw - 4rem));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track {
			animation: none;
			transform: none;
		}

		.quote-card[aria-hidden='true'] {
			display: none;
		}
	}
</style>
