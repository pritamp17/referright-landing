---
import { POLICY, SectionId, SignUpIntent, TrackEvent } from '../lib/constants';
import { TRUST_STRIP, signUpWith } from '../lib/content';
import { INK_DOORS_MASK } from '../lib/ink-doors-asset';
---

{/*
 * The hero makes one argument, visually: everybody is knocking on the same
 * closed doors, and this is the one that opens from the inside.
 *
 * The drawing is not decoration bolted onto a layout — it IS the layout. The
 * copy occupies the quiet left third of the wall; the open door falls on the
 * right, where the eye lands after reading. Nothing overlaps the headline, so
 * there is no text-shadow anywhere in this file.
 */}
<section class="hero" id={SectionId.Top} aria-labelledby="hero-title">
	<div class="hero-wash" aria-hidden="true"></div>
	<div class="grid-texture hero-grid" aria-hidden="true"></div>

	{/*
	 * The artwork is a single alpha mask painted with theme tokens, never a
	 * flat picture: `.ink-base` takes the ink colour, `.ink-accent` re-paints
	 * only the strokes near the open door in the brand blue. One asset, both
	 * themes, no second dark-mode export.
	 */}
	<div class="hero-art" aria-hidden="true">
		<div class="hero-art-inner">
			<div class="ink-stage">
				<span class="hero-glow"></span>
				<span class="ink ink-base"></span>
				<span class="ink ink-accent"></span>
			</div>
		</div>
	</div>

	<div class="shell hero-inner">
		<div class="hero-copy">
			<h1 class="display-1" id="hero-title">
				Find your way in at the <em>right time</em>.
			</h1>
			<p class="lede hero-lede">
				Ask for a referral, give one when you can, or hear about openings before they go public.
			</p>

			<div class="hero-actions">
				<a
					class="button button-primary button-lg"
					href={signUpWith(SignUpIntent.Seeker)}
					data-track={TrackEvent.HeroPrimary}
				>
					<span>Ask for a referral</span>
					<svg viewBox="0 0 16 16" aria-hidden="true">
						<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
					</svg>
				</a>
				<a
					class="button button-ghost button-lg"
					href={signUpWith(SignUpIntent.Giver)}
					data-track={TrackEvent.HeroSecondary}
				>
					I can refer someone
				</a>
			</div>

		</div>

		{/* The drawing earns attention; this rotating pair earns belief. Two cards
		    stay visible while the third quietly pops in to replace one of them. */}
		<div class="hero-proof-stack" aria-label="Recent referral examples">
			<article class="hero-proof-card" data-proof-slot="0" data-proof-index="0">
				<div class="hero-proof-head">
					<span class="hero-proof-status">Referral submitted</span>
					<span class="mono hero-proof-time">{POLICY.confirmationWindowHours}h to confirm</span>
				</div>
				<p class="hero-proof-role">Product Manager</p>
				<p class="hero-proof-meta">Verified employee · screenshot attached</p>
				<span class="hero-proof-bar" aria-hidden="true"><i style="--proof-progress: 78%"></i></span>
			</article>

			<article class="hero-proof-card" data-proof-slot="1" data-proof-index="1">
				<div class="hero-proof-head">
					<span class="hero-proof-status">Referral received</span>
					<span class="mono hero-proof-time">{POLICY.confirmationWindowHours}h to confirm</span>
				</div>
				<p class="hero-proof-role">Software Engineering Intern</p>
				<p class="hero-proof-meta">Employee referral · role match confirmed</p>
				<span class="hero-proof-bar" aria-hidden="true"><i style="--proof-progress: 56%"></i></span>
			</article>
		</div>
	</div>

	{/* Four signals, set as one quiet line rather than four boxes. Boxes here
	    read as a second content block; a rule reads as a footnote. */}
	<div class="shell">
		<ul class="hero-strip">
			{
				TRUST_STRIP.map((item) => (
					<li>
						<strong>{item.value}</strong>
						<span>{item.label}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

{/*
 * The mask itself is set as a real `:root`-level custom property, written
 * once via `set:html`, rather than through Astro's `define:vars`.
 * `define:vars` looked like the natural fit but actually inlines the value as
 * a `style` attribute on every element the component renders — for a ~270KB
 * base64 string that meant 40+ copies of it in the page (measured: 42 copies,
 * an 11MB document). A single `:root` declaration is one copy, inherited by
 * the two rules that use it below like any other custom property.
 */}
<style is:global set:html={`:root { --ink-doors-mask: ${INK_DOORS_MASK}; }`} />

<style>
	.hero {
		position: relative;
		overflow: hidden;
		/* The header overlays this section, so keep hero content below it. */
		padding-top: calc(4.5rem + clamp(2rem, 4vw, 3.25rem));
		padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
		isolation: isolate;
	}

	/* ---- Canvas ---- */

	/*
	 * Two soft washes, not three drifting blobs. The drawing is the subject
	 * now, and an animated aurora behind line art just makes the lines look
	 * like they are floating on someone else's background.
	 */
	.hero-wash {
		position: absolute;
		z-index: 0;
		inset: 0;
		background:
			radial-gradient(60rem 40rem at 78% 18%, rgb(var(--color-primary) / 10%), transparent 68%),
			radial-gradient(48rem 36rem at 8% 88%, rgb(var(--color-reward) / 7%), transparent 70%);
		pointer-events: none;
	}

	:global([data-theme='dark']) .hero-wash {
		background:
			radial-gradient(60rem 40rem at 78% 18%, rgb(var(--color-primary) / 26%), transparent 68%),
			radial-gradient(48rem 36rem at 8% 88%, rgb(var(--color-reward) / 12%), transparent 70%);
	}

	.hero-grid {
		z-index: 0;
		background-size: 3.25rem 3.25rem;
		mask-image: radial-gradient(ellipse 78% 70% at 42% 42%, #000, transparent 76%);
	}

	/* ---- The drawing ---- */

	/*
	 * Three nested masks, each doing exactly one job, because a single element
	 * can only carry one mask reliably across engines:
	 *   .hero-art        — fades the drawing out before it reaches the copy
	 *   .hero-art-inner  — fades it out at the top and bottom edges
	 *   .ink             — the drawing itself
	 */
	.hero-art {
		position: absolute;
		z-index: 0;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		pointer-events: none;
		mask-image: linear-gradient(90deg, transparent 0%, #000 34%);
		-webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 34%);
	}

	.hero-art-inner {
		position: absolute;
		inset: 0;
		/*
		 * A soft defocus on the drawing only. The headline sits on the flat
		 * canvas, never on top of the art, so this never softens type — it only
		 * pushes the wall of doors slightly out of focus, the way a shallow
		 * depth of field keeps a background present without letting it compete
		 * for the eye. The proof card and every other UI element sit outside
		 * this element and stay perfectly sharp.
		 */
		filter: blur(1.25px) saturate(0.94);
		mask-image: linear-gradient(180deg, transparent 0%, #000 13%, #000 62%, transparent 93%);
		-webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 13%, #000 62%, transparent 93%);
	}

	@media (min-width: 90rem) {
		.hero-art-inner {
			filter: blur(1.5px) saturate(0.94);
		}
	}

	/*
	 * The stage is the drawing's own coordinate space, sized by width and held
	 * at its native ratio. Everything below can then be positioned in fractions
	 * of the picture — "38% across, 50% down" is the open door at every
	 * viewport size — instead of in fractions of the section, which drift as
	 * the window changes shape.
	 */
	.ink-stage {
		position: absolute;
		top: 50%;
		right: 0;
		width: 62%;
		aspect-ratio: 1280 / 1636;
		transform: translateY(-50%);
	}

	.ink {
		position: absolute;
		inset: 0;
		/* --ink-doors-mask is set once, above, from ink-doors-asset.ts — see
		   that file for why this is an inline data URI rather than a /public
		   file reference. */
		mask-image: var(--ink-doors-mask);
		mask-repeat: no-repeat;
		mask-size: 100% 100%;
		-webkit-mask-image: var(--ink-doors-mask);
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-size: 100% 100%;
	}

	.ink-base {
		background: rgb(var(--color-ink));
		opacity: 0.5;
	}

	:global([data-theme='dark']) .ink-base {
		opacity: 0.42;
	}

	/*
	 * Only the strokes inside this radius turn blue. The circle is centred on
	 * the open door, so the door, the hand and the light rays pick up the brand
	 * colour and the other two hundred doors stay in ink.
	 */
	.ink-accent {
		background: radial-gradient(
			17% 13% at 38% 50%,
			rgb(var(--color-primary)) 0%,
			rgb(var(--color-primary) / 92%) 52%,
			transparent 100%
		);
	}

	:global([data-theme='dark']) .ink-accent {
		background: radial-gradient(
			17% 13% at 38% 50%,
			rgb(var(--color-primary-strong)) 0%,
			rgb(var(--color-primary-strong) / 90%) 52%,
			transparent 100%
		);
	}

	/* Light actually spilling out of the doorway, behind the linework. */
	.hero-glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(
			26% 20% at 38% 50%,
			rgb(var(--color-primary) / 16%),
			transparent 62%
		);
	}

	:global([data-theme='dark']) .hero-glow {
		background: radial-gradient(
			30% 24% at 38% 50%,
			rgb(var(--color-primary) / 34%),
			transparent 64%
		);
	}

	/* ---- Copy ---- */

	.hero-inner {
		position: relative;
		z-index: 1;
		display: grid;
		gap: clamp(2rem, 4vw, 3rem);
	}

	.hero-copy {
		max-width: 32rem;
	}

	.hero-lede {
		max-width: 29rem;
	}

	/*
	 * The emphasis is the whole argument of the sentence, so it gets the brand
	 * colour rather than an italic. Louize's italic is decorative; colour is
	 * structural.
	 */
	.display-1 :global(em) {
		color: rgb(var(--color-primary));
		font-style: normal;
	}

	:global([data-theme='dark']) .display-1 :global(em) {
		color: rgb(var(--color-primary-strong));
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: clamp(1.75rem, 3vw, 2.25rem);
	}

	/* ---- Proof card ---- */

	.hero-proof-stack {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		width: min(42rem, 100%);
		margin: 0;
		pointer-events: none;
	}

	.hero-proof-card {
		display: grid;
		gap: 0.3125rem;
		margin: 0;
		min-width: 0;
		opacity: 0;
		transform: translateY(-0.5rem) scale(0.985);
		filter: blur(6px);
		padding: 1rem 1.0625rem 1.0625rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-2xl);
		background: rgb(var(--color-surface) / 88%);
		box-shadow: var(--shadow-panel);
		backdrop-filter: blur(18px) saturate(1.3);
		pointer-events: auto;
		transition:
			opacity 1000ms var(--ease-out),
			transform 1000ms var(--ease-out),
			filter 1000ms var(--ease-out);
		visibility: hidden;
	}

	.hero-proof-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.hero-proof-status {
		display: inline-flex;
		align-items: center;
		gap: 0.4375rem;
		color: rgb(var(--color-success-ink));
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.hero-proof-status::before {
		width: 0.4375rem;
		height: 0.4375rem;
		border-radius: 50%;
		background: rgb(var(--color-success));
		box-shadow: 0 0 0 0.25rem rgb(var(--color-success) / 16%);
		content: '';
	}

	:global([data-theme='dark']) .hero-proof-status {
		color: rgb(var(--color-success));
	}

	.hero-proof-time {
		color: rgb(var(--color-muted));
	}

	.hero-proof-role {
		margin: 0.1875rem 0 0;
		font-size: 1.0625rem;
		font-weight: 650;
		letter-spacing: -0.015em;
	}

	.hero-proof-meta {
		margin: 0;
		color: rgb(var(--color-muted));
		font-size: 0.8125rem;
		line-height: 1.45;
	}

	.hero-proof-bar {
		display: block;
		overflow: hidden;
		height: 0.1875rem;
		margin-top: 0.5rem;
		border-radius: var(--radius-pill);
		background: rgb(var(--color-border));
	}

	.hero-proof-bar i {
		display: block;
		width: var(--proof-progress, 72%);
		height: 100%;
		border-radius: inherit;
		background: rgb(var(--color-success));
	}

	/* ---- Trust line ---- */

	.hero-strip {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2.25rem;
		margin: clamp(2rem, 3.5vw, 2.75rem) 0 0;
		padding: 1.25rem 0 0;
		border-top: 1px solid rgb(var(--color-border));
		list-style: none;
	}

	.hero-strip li {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.hero-strip strong {
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.hero-strip span {
		color: rgb(var(--color-muted));
		font-size: 0.8125rem;
	}

	/* ---- Entrance ---- */

	@media (prefers-reduced-motion: no-preference) {
		/* The drawing wipes on left to right, so the wall of closed doors is
		   established before the open one arrives. */
		.hero-art {
			animation: ink-wipe 1500ms var(--ease-out) 120ms both;
		}

		.ink-accent,
		.hero-glow {
			animation: light-on 900ms ease-out 1150ms both;
		}

		.hero-proof-stack.is-ready .hero-proof-card {
			opacity: 1;
			transform: none;
			filter: blur(0);
			visibility: visible;
		}

		@keyframes ink-wipe {
			from {
				clip-path: inset(0 100% 0 0);
			}
			to {
				clip-path: inset(0 0 0 0);
			}
		}

		@keyframes light-on {
			from {
				opacity: 0;
			}
			to {
				opacity: 1;
			}
		}

	}

	/* ---- Responsive ---- */

	/*
	 * Phones and small tablets: the drawing cannot compete with the copy at
	 * this width, so it becomes atmosphere behind it rather than a subject
	 * beside it, and the proof card sits under the buttons as a normal block.
	 */
	@media (max-width: 63.999rem) {
		.hero-art {
			left: 12%;
			mask-image: linear-gradient(90deg, transparent 0%, #000 46%);
			-webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 46%);
			opacity: 0.7;
		}

		.ink-stage {
			top: 44%;
			right: -22%;
			width: 108%;
		}

		.hero-copy {
			max-width: 30rem;
		}

		.hero-proof-stack {
			margin-top: 0.5rem;
		}
	}

	@media (min-width: 64rem) {
		.hero {
			/*
			 * Everything the hero shares the first screen with: the 4.5rem
			 * sticky header, this section's own padding, the trust line, and
			 * air beneath it. The drawing is sized against what is left.
			 */
			--hero-fold-reserve: 17.5rem;

			min-block-size: calc(100vh - 4.5rem);
			min-block-size: calc(100svh - 4.5rem);
			padding-top: clamp(3rem, 5vw, 4.5rem);
		}

		.hero-inner {
			min-block-size: calc(100svh - var(--hero-fold-reserve));
			align-content: center;
		}

		.hero-copy {
			max-width: 34rem;
		}

		/* The two cards occupy quiet pockets around the drawing, never the door. */
		.hero-proof-stack {
			position: absolute;
			inset: 0;
			display: block;
			width: auto;
	}

		.hero-proof-card {
			position: absolute;
			width: min(23rem, 100%);
		}

		/* The upper card sits in the quiet top-right area of the wall. */
		.hero-proof-card[data-proof-slot='0'] {
			top: clamp(0.75rem, 4%, 2.5rem);
			right: 0;
		}

		/* The lower card sits in the highlighted bottom-right pocket. */
		.hero-proof-card[data-proof-slot='1'] {
			right: 0;
			bottom: clamp(1rem, 4vh, 3rem);
		}
	}

	@media (min-width: 90rem) {
		.hero-proof-card[data-proof-slot='0'] {
			right: 4%;
		}

		.hero-proof-card[data-proof-slot='1'] {
			right: -2%;
		}
	}

	@media (max-width: 47.999rem) {
		.hero-proof-stack {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-proof-stack.is-ready .hero-proof-card.is-exiting {
			opacity: 0;
			transform: translateY(0.5rem) scale(0.985);
			filter: blur(6px);
		}

		.hero-proof-stack.is-ready .hero-proof-card.is-entering {
			opacity: 0;
			transform: translateY(-0.5rem) scale(0.985);
			filter: blur(6px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-proof-stack.is-ready .hero-proof-card {
			opacity: 1;
			transform: none;
			filter: none;
			transition: none;
			visibility: visible;
		}
	}
</style>

<script>
	interface ProofCard {
		role: string;
		meta: string;
		progress: string;
	}

	const proofCards: readonly ProofCard[] = [
		{
			role: 'Product Manager',
			meta: 'Verified employee · screenshot attached',
			progress: '78%',
		},
		{
			role: 'Software Engineering Intern',
			meta: 'Employee referral · role match confirmed',
			progress: '56%',
		},
		{
			role: 'UI/UX Designer',
			meta: 'Verified employee · portfolio reviewed',
			progress: '88%',
		},
	];

	const proofStack = document.querySelector<HTMLElement>('.hero-proof-stack');
	const proofArt = document.querySelector<HTMLElement>('.hero-art');
	const proofSlots = Array.from(document.querySelectorAll<HTMLElement>('[data-proof-slot]'));
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (proofStack && proofSlots.length === 2) {
		let nextSlotIndex = 0;
		let rotationStarted = false;

		const scheduleNext = (): void => {
			window.setTimeout(() => {
				const visibleIndexes = new Set(
					proofSlots.map((slot) => Number(slot.dataset.proofIndex)),
				);
				const nextIndex = proofCards.findIndex((_, index) => !visibleIndexes.has(index));
				const slot = proofSlots[nextSlotIndex];
				const nextCard = proofCards[nextIndex];

				if (!slot || !nextCard) return;

				nextSlotIndex = (nextSlotIndex + 1) % 2;
				slot.classList.remove('is-entering');
				slot.classList.add('is-exiting');

				window.setTimeout(() => {
					slot.classList.remove('is-exiting');
					slot.dataset.proofIndex = String(nextIndex);
					const role = slot.querySelector<HTMLElement>('.hero-proof-role');
					const meta = slot.querySelector<HTMLElement>('.hero-proof-meta');
					const progress = slot.querySelector<HTMLElement>('.hero-proof-bar i');
					if (role) role.textContent = nextCard.role;
					if (meta) meta.textContent = nextCard.meta;
					progress?.style.setProperty('--proof-progress', nextCard.progress);

					slot.classList.add('is-entering');
					window.requestAnimationFrame(() => {
						window.requestAnimationFrame(() => slot.classList.remove('is-entering'));
					});
				}, 1000);

				// Start each new transition on a four-second rhythm.
				scheduleNext();
			}, 4000);
		};

		const revealCards = (): void => {
			window.setTimeout(() => {
				if (rotationStarted) return;
				rotationStarted = true;
				proofStack.classList.add('is-ready');
				if (!reducedMotion) scheduleNext();
			}, 1000);
		};

		if (reducedMotion || !proofArt) {
			revealCards();
		} else {
			const fallback = window.setTimeout(revealCards, 1800);
			proofArt.addEventListener(
				'animationend',
				(event) => {
					if (event.animationName !== 'ink-wipe') return;
					window.clearTimeout(fallback);
					revealCards();
				},
				{ once: true },
			);
		}
	}
</script>
