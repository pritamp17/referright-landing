---
import DoorWall from './DoorWall.astro';
import HeroScrollCue from './HeroScrollCue.astro';
import { POLICY, SectionId, SignUpIntent, TrackEvent } from '../lib/constants';
import { TRUST_STRIP, signUpWith } from '../lib/content';
---

{/*
 * The hero makes one argument, visually: everybody is knocking on the same
 * closed doors, and this is the one that opens from the inside.
 *
 * The drawing is not decoration bolted onto a layout — it IS the layout. The
 * copy occupies the quiet left third of the wall; the open door falls on the
 * right, where the eye lands after reading. Nothing overlaps the headline, so
 * there is no text-shadow anywhere in this file.
 */}
<section class="hero" id={SectionId.Top} aria-labelledby="hero-title">
	<div class="hero-wash" aria-hidden="true"></div>
	<div class="grid-texture hero-grid" aria-hidden="true"></div>

	{/* The wall itself lives in DoorWall.astro, because the closing section
	    ends the page on the same image. */}
	<DoorWall variant="hero" class="hero-art" />

	<div class="shell hero-inner">
		<div class="hero-copy">
			<h1 class="display-1" id="hero-title">
				Find your way in at the <em>right time</em>.
			</h1>
			<p class="lede hero-lede">
				Get notified about roles that match your experience, ask for a referral, or give one if you can.
			</p>

			<div class="hero-actions">
				<a
					class="button button-primary button-lg"
					href={signUpWith(SignUpIntent.Seeker)}
					data-track={TrackEvent.HeroPrimary}
				>
					<span>Ask for a referral</span>
					<svg viewBox="0 0 16 16" aria-hidden="true">
						<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
					</svg>
				</a>
				<a
					class="button button-ghost button-lg"
					href={signUpWith(SignUpIntent.Giver)}
					data-track={TrackEvent.HeroSecondary}
				>
					I can refer someone
				</a>
			</div>

		</div>

		{/* The drawing earns attention; this rotating pair earns belief. Two cards
		    stay visible while the third quietly pops in to replace one of them. */}
		<div class="hero-proof-stack" aria-label="Recent referral examples">
			<article class="hero-proof-card" data-proof-slot="0" data-cycle-index="0">
				<div class="hero-proof-head">
					<span class="hero-proof-status">Referral submitted</span>
					<span class="mono hero-proof-time">{POLICY.confirmationWindowHours}h to confirm</span>
				</div>
				<p class="hero-proof-role">Product Manager</p>
				<p class="hero-proof-meta">Verified employee · screenshot attached</p>
				<span class="hero-proof-bar" aria-hidden="true"><i style="--proof-progress: 78%"></i></span>
			</article>

			<article class="hero-proof-card" data-proof-slot="1" data-cycle-index="1">
				<div class="hero-proof-head">
					<span class="hero-proof-status">Referral received</span>
					<span class="mono hero-proof-time">{POLICY.confirmationWindowHours}h to confirm</span>
				</div>
				<p class="hero-proof-role">Software Engineering Intern</p>
				<p class="hero-proof-meta">Employee referral · role match confirmed</p>
				<span class="hero-proof-bar" aria-hidden="true"><i style="--proof-progress: 56%"></i></span>
			</article>
		</div>
	</div>

	{/* Four signals, set as one quiet line rather than four boxes. Boxes here
	    read as a second content block; a rule reads as a footnote. The scroll
	    cue shares the same block so the two sit on one baseline. */}
	<div class="shell hero-foot">
		<ul class="hero-strip">
			{
				TRUST_STRIP.map((item) => (
					<li>
						<strong>{item.value}</strong>
						<span>{item.label}</span>
					</li>
				))
			}
		</ul>
		<HeroScrollCue />
	</div>
</section>

<style>
	/*
	 * The hero owns the whole first screen. The sticky header is pulled back
	 * over this section with a negative margin, so the section box already
	 * starts at the top of the viewport: one `100svh` here is the full fold,
	 * and nothing from the next section can peek in under it.
	 */
	.hero {
		position: relative;
		display: flex;
		overflow: hidden;
		min-block-size: 100vh;
		min-block-size: 100svh;
		flex-direction: column;
		/* The header overlays this section, so keep hero content below it. */
		padding-top: calc(4.5rem + clamp(1.5rem, 3vw, 2.5rem));
		padding-bottom: clamp(2rem, 4vw, 3.25rem);
		isolation: isolate;
	}

	/* ---- Canvas ---- */

	/*
	 * Two soft washes, not three drifting blobs. The drawing is the subject
	 * now, and an animated aurora behind line art just makes the lines look
	 * like they are floating on someone else's background.
	 *
	 * Both washes are the brand blue. The lower one used to be `reward`, which
	 * was a second blue when it was written and became violet when the palette
	 * was re-synced with the product, putting a colour the hero has no use for
	 * across the bottom of the first screen. `reward` means money here, and
	 * money is not what this section is about.
	 */
	.hero-wash {
		position: absolute;
		z-index: 0;
		inset: 0;
		background:
			radial-gradient(60rem 40rem at 78% 18%, rgb(var(--color-primary) / 10%), transparent 68%),
			radial-gradient(52rem 38rem at 6% 90%, rgb(var(--color-primary) / 5%), transparent 70%);
		pointer-events: none;
	}

	:global([data-theme='dark']) .hero-wash {
		background:
			radial-gradient(60rem 40rem at 78% 18%, rgb(var(--color-primary) / 26%), transparent 68%),
			radial-gradient(52rem 38rem at 6% 90%, rgb(var(--color-primary) / 10%), transparent 70%);
	}

	.hero-grid {
		z-index: 0;
		background-size: 3.25rem 3.25rem;
		mask-image: radial-gradient(ellipse 78% 70% at 42% 42%, #000, transparent 76%);
	}

	/* ---- Copy ---- */

	.hero-inner {
		position: relative;
		z-index: 1;
		display: grid;
		flex: 1 1 auto;
		align-content: center;
		gap: clamp(2rem, 4vw, 3rem);
	}

	.hero-copy {
		max-width: 32rem;
	}

	.hero-lede {
		max-width: 29rem;
	}

	/*
	 * The emphasis is the whole argument of the sentence, so it gets the brand
	 * colour rather than an italic. Louize's italic is decorative; colour is
	 * structural.
	 */
	.display-1 :global(em) {
		color: rgb(var(--color-primary));
		font-style: normal;
	}

	:global([data-theme='dark']) .display-1 :global(em) {
		color: rgb(var(--color-primary-strong));
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: clamp(1.75rem, 3vw, 2.25rem);
	}

	/* ---- Proof card ---- */

	.hero-proof-stack {
		/* Shared with the rotation script below — keep the two in step. */
		--proof-dur: 1100ms;

		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		width: min(42rem, 100%);
		margin: 0;
		pointer-events: none;
	}

	/*
	 * The cards float on the hero rather than sit on it: a low-alpha surface
	 * plus a heavy backdrop blur lets the drawing and the wash read straight
	 * through them, so they behave like glass over the artwork instead of two
	 * opaque panels parked on top of it.
	 */
	.hero-proof-card {
		display: grid;
		gap: 0.3125rem;
		margin: 0;
		min-width: 0;
		opacity: 0;
		transform: translateY(-0.375rem) scale(0.99);
		filter: blur(4px);
		padding: 1rem 1.0625rem 1.0625rem;
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-2xl);
		background: var(--glass-bg);
		box-shadow:
			var(--glass-shadow),
			inset 0 1px 0 var(--glass-highlight);
		backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
		-webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.4);
		pointer-events: auto;
		transition:
			opacity var(--proof-dur) var(--ease-out),
			transform var(--proof-dur) var(--ease-out),
			filter var(--proof-dur) var(--ease-out);
		visibility: hidden;
	}

	.hero-proof-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.hero-proof-status {
		display: inline-flex;
		align-items: center;
		gap: 0.4375rem;
		color: rgb(var(--color-success-ink));
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.hero-proof-status::before {
		width: 0.4375rem;
		height: 0.4375rem;
		border-radius: 50%;
		background: rgb(var(--color-success));
		box-shadow: 0 0 0 0.25rem rgb(var(--color-success) / 16%);
		content: '';
	}

	:global([data-theme='dark']) .hero-proof-status {
		color: rgb(var(--color-success));
	}

	.hero-proof-time {
		color: rgb(var(--color-muted));
	}

	.hero-proof-role {
		margin: 0.1875rem 0 0;
		font-size: 1.0625rem;
		font-weight: 650;
		letter-spacing: -0.015em;
	}

	.hero-proof-meta {
		margin: 0;
		color: rgb(var(--color-muted));
		font-size: 0.8125rem;
		line-height: 1.45;
	}

	.hero-proof-bar {
		display: block;
		overflow: hidden;
		height: 0.1875rem;
		margin-top: 0.5rem;
		border-radius: var(--radius-pill);
		background: rgb(var(--color-border) / 55%);
	}

	.hero-proof-bar i {
		display: block;
		width: var(--proof-progress, 72%);
		height: 100%;
		border-radius: inherit;
		background: rgb(var(--color-success) / 80%);
		/* Moves on the same clock as the card it belongs to. */
		transition: width var(--proof-dur) var(--ease-out);
	}

	/* ---- Trust line ---- */

	.hero-foot {
		position: relative;
		z-index: 1;
		display: grid;
		flex: 0 0 auto;
		gap: clamp(0.75rem, 2vw, 1.125rem);
		margin-top: clamp(1.5rem, 3vw, 2.25rem);
	}

	.hero-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2.25rem;
		margin: 0;
		padding: 1.25rem 0 0;
		border-top: 1px solid rgb(var(--color-border));
		list-style: none;
	}

	.hero-strip li {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.hero-strip strong {
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.hero-strip span {
		color: rgb(var(--color-muted));
		font-size: 0.8125rem;
	}

	/* ---- Entrance ---- */

	@media (prefers-reduced-motion: no-preference) {
		/* The cards arrive after the wall has been drawn — see the script
		   below, which waits on DoorWall's own `ink-wipe`. */
		.hero-proof-stack.is-ready .hero-proof-card {
			opacity: 1;
			transform: none;
			filter: blur(0);
			visibility: visible;
		}
	}

	/* ---- Responsive ---- */

	/*
	 * Phones and small tablets: the drawing cannot compete with the copy at
	 * this width, so it becomes atmosphere behind it rather than a subject
	 * beside it, and the proof card sits under the buttons as a normal block.
	 */
	@media (max-width: 63.999rem) {
		.hero-copy {
			max-width: 30rem;
		}

		.hero-proof-stack {
			margin-top: 0.5rem;
		}
	}

	@media (min-width: 64rem) {
		.hero {
			padding-top: calc(4.5rem + clamp(1.5rem, 3vw, 3rem));
		}

		.hero-copy {
			max-width: 34rem;
		}

		/* The two cards occupy quiet pockets around the drawing, never the door. */
		.hero-proof-stack {
			position: absolute;
			inset: 0;
			display: block;
			width: auto;
		}

		.hero-proof-card {
			position: absolute;
			width: min(23rem, 100%);
		}

		/* The upper card sits in the quiet top-right area of the wall. */
		.hero-proof-card[data-proof-slot='0'] {
			top: clamp(0.75rem, 4%, 2.5rem);
			right: 0;
		}

		/* The lower card sits in the highlighted bottom-right pocket. */
		.hero-proof-card[data-proof-slot='1'] {
			right: 0;
			bottom: clamp(1rem, 4vh, 3rem);
		}
	}

	@media (min-width: 90rem) {
		.hero-proof-card[data-proof-slot='0'] {
			right: 4%;
		}

		.hero-proof-card[data-proof-slot='1'] {
			right: -2%;
		}
	}

	@media (max-width: 47.999rem) {
		.hero-proof-stack {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		/* A short, equal lift in both directions — enough to read as motion,
		   not enough to look like the card is being thrown. */
		.hero-proof-stack.is-ready .hero-proof-card.is-exiting {
			opacity: 0;
			transform: translateY(0.375rem) scale(0.99);
			filter: blur(4px);
		}

		.hero-proof-stack.is-ready .hero-proof-card.is-entering {
			opacity: 0;
			transform: translateY(-0.375rem) scale(0.99);
			filter: blur(4px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-proof-stack.is-ready .hero-proof-card {
			opacity: 1;
			transform: none;
			filter: none;
			transition: none;
			visibility: visible;
		}
	}
</style>

<script>
	import { startCardCycle } from '../lib/card-cycle';

	interface ProofCard {
		readonly role: string;
		readonly meta: string;
		readonly progress: string;
	}

	const proofCards: readonly ProofCard[] = [
		{ role: 'Product Manager', meta: 'Verified employee · screenshot attached', progress: '78%' },
		{ role: 'Software Engineering Intern', meta: 'Employee referral · role match confirmed', progress: '56%' },
		{ role: 'UI/UX Designer', meta: 'Verified employee · portfolio reviewed', progress: '88%' },
	];

	const stack = document.querySelector<HTMLElement>('.hero-proof-stack');
	const art = document.querySelector<HTMLElement>('.hero-art');
	const slots = Array.from(document.querySelectorAll<HTMLElement>('[data-proof-slot]'));
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	/* The cards arrive once the drawing has settled: after the ink-wipe ends,
	   or after a fallback timer if the animation never reports back. */
	const artSettled = new Promise<void>((resolve) => {
		if (reducedMotion || !art) {
			resolve();
			return;
		}
		const fallback = window.setTimeout(resolve, 1800);
		art.addEventListener(
			'animationend',
			(event) => {
				if (event.animationName !== 'ink-wipe') return;
				window.clearTimeout(fallback);
				resolve();
			},
			{ once: true },
		);
	});

	if (stack && slots.length === 2) {
		startCardCycle<ProofCard>({
			stack,
			slots,
			pool: proofCards,
			/* Mirrors `--proof-dur` in the stylesheet: the card fades out over
			   exactly this long, so the swap lands on the frame it finishes. */
			transitionMs: 1100,
			/* One full turn, fade-out and fade-in included. Deliberately
			   unhurried — the card is meant to be read, not caught. */
			cycleMs: 7200,
			/* Air between the drawing settling and the cards arriving. */
			revealDelayMs: 1400,
			ready: artSettled,
			render: (slot, card) => {
				const role = slot.querySelector<HTMLElement>('.hero-proof-role');
				const meta = slot.querySelector<HTMLElement>('.hero-proof-meta');
				const progress = slot.querySelector<HTMLElement>('.hero-proof-bar i');
				if (role) role.textContent = card.role;
				if (meta) meta.textContent = card.meta;
				progress?.style.setProperty('--proof-progress', card.progress);
			},
		});
	}
</script>
