---
import { PEER_EXAMPLE } from '../lib/content';

const { opening, nodes } = PEER_EXAMPLE;
---

<figure class="peer-diagram">
	<div class="peer-source">
		<p class="peer-source-label mono">Referral requested</p>
		<p class="peer-source-role">{opening.role}</p>
		<p class="peer-source-company">{opening.company}</p>
	</div>

	<div class="peer-rule" aria-hidden="true">
		<span class="peer-rule-line"></span>
		<span class="peer-rule-chip mono">same function · ±1 band</span>
		<span class="peer-rule-line"></span>
	</div>

	<ul class="peer-nodes">
		{
			nodes.map((node) => (
				<li class:list={['peer-node', node.matched ? 'is-matched' : 'is-excluded']}>
					<span class="peer-node-state" aria-hidden="true">
						{node.matched ? (
							<svg viewBox="0 0 16 16">
								<path d="M3.4 8.4l3 3 6.2-7" />
							</svg>
						) : (
							<svg viewBox="0 0 16 16">
								<path d="M5 5l6 6M11 5l-6 6" />
							</svg>
						)}
					</span>
					<span class="peer-node-body">
						<strong>{node.role}</strong>
						<span class="peer-node-company">{node.company}</span>
						<span class="peer-node-reason mono">{node.reason}</span>
					</span>
				</li>
			))
		}
	</ul>

	<figcaption class="peer-privacy">
		<svg viewBox="0 0 16 16" aria-hidden="true">
			<path d="M8 1.6 2.9 3.8v3.5c0 3.2 2.1 6 5.1 7 3-1 5.1-3.8 5.1-7V3.8Z"></path>
			<path d="M8 6.4v3.2"></path>
		</svg>
		<span>
			Peers are shown <strong>the opening</strong>, never the person who asked for the referral.
			Opt-in, and off by default.
		</span>
	</figcaption>
</figure>

<style>
	.peer-diagram {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: clamp(1.25rem, 3vw, 1.75rem);
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-xxl);
		background: rgb(var(--color-surface));
		box-shadow: var(--shadow-panel);
	}

	/* ---- Source ---- */

	.peer-source {
		display: grid;
		gap: 0.125rem;
		padding: 1rem 1.125rem;
		border: 1px solid rgb(var(--color-primary) / 28%);
		border-radius: var(--radius-2xl);
		background: rgb(var(--color-primary-soft));
		text-align: center;
	}

	.peer-source-label {
		margin: 0;
		color: rgb(var(--color-primary-strong));
		text-transform: uppercase;
	}

	.peer-source-role {
		margin: 0.25rem 0 0;
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.peer-source-company {
		margin: 0;
		color: rgb(var(--color-muted));
		font-size: 0.875rem;
	}

	/* ---- Matching rule ---- */

	.peer-rule {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.peer-rule-line {
		height: 1px;
		flex: 1;
		background: rgb(var(--color-border));
	}

	.peer-rule-chip {
		padding: 0.3125rem 0.625rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-pill);
		background: rgb(var(--color-elevated));
		color: rgb(var(--color-muted));
		white-space: nowrap;
	}

	/* ---- Peer nodes ---- */

	.peer-nodes {
		display: grid;
		gap: 0.625rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.peer-node {
		display: grid;
		grid-template-columns: 1.5rem 1fr;
		gap: 0.75rem;
		align-items: start;
		padding: 0.875rem 1rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-2xl);
		background: rgb(var(--color-canvas));
	}

	.peer-node.is-matched {
		border-color: rgb(var(--color-success) / 34%);
		background: rgb(var(--color-success-soft) / 42%);
	}

	.peer-node.is-excluded {
		opacity: 0.72;
	}

	.peer-node-state {
		display: grid;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		place-items: center;
	}

	.peer-node.is-matched .peer-node-state {
		background: rgb(var(--color-success) / 18%);
	}

	.peer-node.is-excluded .peer-node-state {
		background: rgb(var(--color-muted) / 14%);
	}

	.peer-node-state svg {
		width: 0.875rem;
		height: 0.875rem;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	.peer-node.is-matched svg {
		stroke: rgb(var(--color-success-ink));
	}

	:global([data-theme='dark']) .peer-node.is-matched svg {
		stroke: rgb(var(--color-success));
	}

	.peer-node.is-excluded svg {
		stroke: rgb(var(--color-muted));
	}

	.peer-node-body {
		display: grid;
		gap: 0.0625rem;
		min-width: 0;
	}

	.peer-node-body strong {
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.peer-node-company {
		color: rgb(var(--color-muted));
		font-size: 0.8125rem;
	}

	.peer-node-reason {
		margin-top: 0.1875rem;
		color: rgb(var(--color-muted));
		font-size: 0.6875rem;
	}

	/* ---- Privacy note ---- */

	.peer-privacy {
		display: grid;
		grid-template-columns: 1.125rem 1fr;
		gap: 0.625rem;
		align-items: start;
		margin-top: 0.25rem;
		padding-top: 1rem;
		border-top: 1px solid rgb(var(--color-border));
		color: rgb(var(--color-muted));
		font-size: 0.8125rem;
		line-height: 1.5;
	}

	.peer-privacy svg {
		width: 1.125rem;
		height: 1.125rem;
		margin-top: 0.0625rem;
		fill: none;
		stroke: rgb(var(--color-primary));
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.4;
	}

	:global([data-theme='dark']) .peer-privacy svg {
		stroke: rgb(var(--color-primary-strong));
	}

	/* ---- Responsive ----
	   A radial fan-out cannot stay radial on a 360px screen, so the default is a
	   vertical stack. From 48rem the peers sit in a two-column field beneath the
	   opening, which reads as a fan without needing SVG connector maths. */

	@media (min-width: 48rem) {
		.peer-nodes {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
