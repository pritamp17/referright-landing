---
import {
	siAirbnb,
	siApple,
	siAtlassian,
	siCisco,
	siDropbox,
	siFigma,
	siGithub,
	siGoogle,
	siIntel,
	siMeta,
	siNetflix,
	siNvidia,
	siPaypal,
	siSpotify,
	siStripe,
	siUber,
	siZoom,
} from 'simple-icons';

interface SimpleIcon {
	readonly path: string;
	readonly hex: string;
}

interface Company {
	readonly name: string;
	readonly icon: SimpleIcon;
}

const companies: readonly Company[] = [
	{ name: 'Google', icon: siGoogle },
	{ name: 'Atlassian', icon: siAtlassian },
	{ name: 'Uber', icon: siUber },
	{ name: 'Meta', icon: siMeta },
	{ name: 'Netflix', icon: siNetflix },
	{ name: 'Spotify', icon: siSpotify },
	{ name: 'Airbnb', icon: siAirbnb },
	{ name: 'Figma', icon: siFigma },
	{ name: 'NVIDIA', icon: siNvidia },
	{ name: 'GitHub', icon: siGithub },
	{ name: 'PayPal', icon: siPaypal },
	{ name: 'Stripe', icon: siStripe },
	{ name: 'Zoom', icon: siZoom },
	{ name: 'Dropbox', icon: siDropbox },
	{ name: 'Cisco', icon: siCisco },
	{ name: 'Intel', icon: siIntel },
	{ name: 'Apple', icon: siApple },
];

/* Duplicated once so the marquee can loop seamlessly at -50%. */
const marquee: readonly Company[] = [...companies, ...companies];
---

<div class="company-field" aria-label="Examples of companies people request referrals into">
	<div class="company-track">
		{
			marquee.map((company, index) => (
				<span class="company-chip" aria-hidden={index >= companies.length ? 'true' : undefined}>
					<svg viewBox="0 0 24 24" role="img" aria-label={`${company.name} logo`}>
						<path d={company.icon.path} />
					</svg>
					<span>{company.name}</span>
				</span>
			))
		}
	</div>
</div>

<style>
	.company-field {
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
	}

	.company-track {
		display: flex;
		width: max-content;
		align-items: center;
		gap: 0.75rem;
		animation: company-drift 60s linear infinite;
	}

	.company-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.625rem 1rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-pill);
		background: rgb(var(--color-surface));
		color: rgb(var(--color-muted));
		font-size: 0.875rem;
		font-weight: 500;
		white-space: nowrap;
	}

	/* Logos are rendered in ink, not in brand colours — a wall of competing
	   brand hues would fight the page's single blue accent. */
	.company-chip svg {
		width: 1.125rem;
		height: 1.125rem;
		flex: 0 0 auto;
		fill: rgb(var(--color-ink) / 62%);
	}

	@keyframes company-drift {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(calc(-50% - 0.375rem));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.company-track {
			flex-wrap: wrap;
			width: 100%;
			animation: none;
			justify-content: center;
		}

		.company-chip[aria-hidden='true'] {
			display: none;
		}
	}
</style>
