---
import SectionIntro from './SectionIntro.astro';
import { OfferingKind, SectionId, TrackEvent } from '../lib/constants';
import { OFFERINGS } from '../lib/content';

/** Analytics event per offering, resolved from the enum rather than inlined. */
const TRACK_BY_KIND: Readonly<Record<OfferingKind, TrackEvent>> = {
	[OfferingKind.AskForReferral]: TrackEvent.OfferingAsk,
	[OfferingKind.GiveReferral]: TrackEvent.OfferingGive,
	[OfferingKind.PeerSignal]: TrackEvent.OfferingPeer,
};

/*
 * Three doors in one wall.
 *
 * This section previously drew the argument literally: a hub on a horizontal
 * spine with three connectors dropping to three roles. It failed twice. The
 * hub sat on top of the middle column's connector so the outer two dots read
 * as unexplained specks, and it spent roughly seven vertical rems to carry
 * three short lines of text. Worse, the whole diagram was `display: none`
 * below 64rem — so the geometry earned nothing at all on a phone, which is
 * where most of this traffic is.
 *
 * "One network, three ways in" is now made structurally instead of drawn:
 * three cells inside a single bordered frame, divided by hairlines. Belonging
 * to one frame IS the argument, it holds at every width, and it rhymes with
 * the wall of doors in the hero. The frame is the same composition the trust
 * pillars use, so the page's two explanatory sections read as one system.
 *
 * Each cell carries an accent rule rather than an accent fill — the product
 * application's own "state is a rail, not a fill" convention, so the marketing
 * page and the signed-in product argue in the same visual language.
 *
 * ONE accent, not three, and deliberately so. Rendering each door in its own
 * `offering.accent` looks right on paper but does not survive the palette: in
 * dark mode `--color-primary-soft` and `--color-reward-soft` are both
 * `16 42 67`, and `--color-primary-strong` and `--color-reward-ink` are both
 * `112 181 249` — so "Ask for a referral" and "Hear about openings" render
 * pixel-identical, and even in light mode both resolve to near-identical pale
 * blues. The palette is locked, so the fix is not to lean on it: identity comes
 * from the numeral and the icon silhouette, which are unambiguous in both
 * themes. It also states the section's actual claim better — one network, so
 * one colour, entered three ways.
 */
const ROLE_ICON: Readonly<Record<OfferingKind, string>> = {
	[OfferingKind.AskForReferral]: 'M3 14h10M9 9l4 5-4 5M16.5 4h8v20h-8',
	[OfferingKind.GiveReferral]: 'M5 14.5l5.5 5.5L23 7',
	[OfferingKind.PeerSignal]: 'M11 10a5.6 5.6 0 0 1 0 8M14.4 6.8a10 10 0 0 1 0 14.4',
};
---

<section class="section offerings" id={SectionId.Offerings} aria-labelledby="offerings-title">
	<div class="shell">
		<SectionIntro
			eyebrow="Three ways to use RightRefer"
			title="One network. Three ways in."
			copy="The same verified network, entered from whichever side you are on today. You can be on more than one."
			headingId="offerings-title"
			align="center"
			class="reveal"
		/>

		<ul class="doors accent-primary reveal">
			{
				OFFERINGS.map((offering, index) => (
					<li class="door">
						<span class="door-index mono">{String(index + 1).padStart(2, '0')}</span>
						<span class="door-rule" aria-hidden="true" />

						<span class="door-icon" aria-hidden="true">
							<svg viewBox="0 0 28 28">
								<path d={ROLE_ICON[offering.kind]} />
								{offering.kind === OfferingKind.PeerSignal && (
									<circle cx="7" cy="14" r="1.5" fill="currentColor" stroke="none" />
								)}
							</svg>
						</span>

						<h3 class="door-title">{offering.title}</h3>
						<p class="door-line">{offering.line}</p>

						<a class="text-link door-cta" href={offering.ctaHref} data-track={TRACK_BY_KIND[offering.kind]}>
							{offering.ctaLabel}
							<svg viewBox="0 0 16 16" aria-hidden="true">
								<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" />
							</svg>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/*
	 * The shared canvas, like every other section. Separation on this page comes
	 * from the frame below sitting ON the canvas, not from repainting the band —
	 * alternating section backgrounds reads as stripes, and it makes the page
	 * argue with itself rather than hold together.
	 */
	.offerings {
		border-top: 1px solid rgb(var(--color-border));
	}

	/*
	 * The frame. A 1px grid gap over an ink-tinted backdrop draws every divider
	 * — between and around the cells — in one declaration, and stays a true
	 * neutral in both themes. Drawing these in brand blue is the trap the trust
	 * section already documented: blue-on-blue vanishes in light mode.
	 */
	.doors {
		display: grid;
		gap: 1px;
		margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
		padding: 0;
		overflow: hidden;
		border: 1px solid rgb(var(--color-ink) / 14%);
		border-radius: var(--radius-xxl);
		background: rgb(var(--color-ink) / 12%);
		box-shadow: var(--shadow-raised);
		list-style: none;
	}

	/*
	 * `grid` + `1fr` on the copy row is what pins all three CTAs to a shared
	 * baseline no matter how the one-liners wrap.
	 */
	.door {
		display: grid;
		grid-template-rows: auto auto auto auto 1fr auto;
		padding: clamp(1.5rem, 3vw, 2rem);
		background: rgb(var(--color-surface));
	}

	.door-index {
		color: rgb(var(--color-muted));
		font-weight: 600;
	}

	.door-rule {
		width: 2rem;
		height: 2px;
		margin-top: 0.875rem;
		border-radius: var(--radius-pill);
		background: rgb(var(--accent));
	}

	.door-icon {
		display: inline-grid;
		width: 3rem;
		height: 3rem;
		margin-top: 1.5rem;
		place-items: center;
		border-radius: 50%;
		background: rgb(var(--accent-soft));
	}

	.door-icon svg {
		width: 1.375rem;
		height: 1.375rem;
		fill: none;
		stroke: rgb(var(--accent-ink));
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.door-title {
		margin: 1.125rem 0 0;
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.door-line {
		margin: 0.4375rem 0 0;
		color: rgb(var(--color-muted));
		font-size: 0.9375rem;
		line-height: 1.55;
	}

	.door-cta {
		margin-top: 1rem;
	}

	/* ---- Responsive ----
	   Single column is the phone layout. The frame simply becomes three columns
	   from 64rem; nothing is hidden at any width. */

	@media (min-width: 64rem) {
		.doors {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
