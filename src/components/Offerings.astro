---
import SectionIntro from './SectionIntro.astro';
import { OfferingKind, SectionId, TrackEvent } from '../lib/constants';
import { OFFERINGS } from '../lib/content';

/** Analytics event per offering, resolved from the enum rather than inlined. */
const TRACK_BY_KIND: Readonly<Record<OfferingKind, TrackEvent>> = {
	[OfferingKind.AskForReferral]: TrackEvent.OfferingAsk,
	[OfferingKind.GiveReferral]: TrackEvent.OfferingGive,
	[OfferingKind.PeerSignal]: TrackEvent.OfferingPeer,
};

/*
 * Three chapters of eyebrow + heading + paragraph + three bullets each used to
 * make this argument in roughly 300 words. It is one idea — one verified
 * network, three ways to use it — so it is now one diagram: a hub with three
 * roles radiating from it, each carrying a two-word title and a single line.
 * The connecting spine and hub are decorative (aria-hidden); every role's
 * title, line and CTA are real text, so nothing here depends on the graphic
 * to be understood or found.
 */
const ROLE_ICON: Readonly<Record<OfferingKind, string>> = {
	[OfferingKind.AskForReferral]: 'M3 14h10M9 9l4 5-4 5M16.5 4h8v20h-8',
	[OfferingKind.GiveReferral]: 'M5 14.5l5.5 5.5L23 7',
	[OfferingKind.PeerSignal]: 'M11 10a5.6 5.6 0 0 1 0 8M14.4 6.8a10 10 0 0 1 0 14.4',
};
---

<section class="section offerings" id={SectionId.Offerings} aria-labelledby="offerings-title">
	<div class="shell">
		<SectionIntro
			eyebrow="Three ways to use RightRefer"
			title="One network. Three ways in."
			headingId="offerings-title"
			align="center"
			class="reveal"
		/>

		<div class="network reveal">
			<div class="network-spine" aria-hidden="true">
				<span class="network-hub">
					<svg viewBox="0 0 20 20" aria-hidden="true">
						<circle cx="10" cy="4" r="1.6"></circle>
						<circle cx="4" cy="15.5" r="1.6"></circle>
						<circle cx="16" cy="15.5" r="1.6"></circle>
						<path d="M10 4 4 15.5M10 4l6 11.5M4.9 15.5h10.2"></path>
					</svg>
				</span>
			</div>

			<ul class="network-roles">
				{
					OFFERINGS.map((offering) => (
						<li class:list={['network-role', `accent-${offering.accent}`]}>
							<span class="role-connector" aria-hidden="true" />
							<span class="role-icon">
								<svg viewBox="0 0 28 28" aria-hidden="true">
									<path d={ROLE_ICON[offering.kind]} />
									{offering.kind === OfferingKind.PeerSignal && (
										<circle cx="7" cy="14" r="1.5" fill="currentColor" stroke="none" />
									)}
								</svg>
							</span>
							<h3 class="role-title">{offering.title}</h3>
							<p class="role-line">{offering.line}</p>
							<a class="text-link role-cta" href={offering.ctaHref} data-track={TRACK_BY_KIND[offering.kind]}>
								{offering.ctaLabel}
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" />
								</svg>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.offerings {
		border-top: 1px solid rgb(var(--color-border));
	}

	.network {
		position: relative;
		margin-top: clamp(2.5rem, 5vw, 3.5rem);
	}

	/* ---- Spine + hub (decorative) ---- */

	.network-spine {
		position: absolute;
		top: 2.25rem;
		right: 12%;
		left: 12%;
		height: 1px;
		background: rgb(var(--color-border));
	}

	.network-hub {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		width: 3rem;
		height: 3rem;
		place-items: center;
		border: 1px solid rgb(var(--color-border));
		border-radius: 50%;
		background: rgb(var(--color-surface));
		box-shadow: var(--shadow-raised);
		transform: translate(-50%, -50%);
	}

	.network-hub svg {
		width: 1.375rem;
		height: 1.375rem;
		fill: none;
		stroke: rgb(var(--color-primary));
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.4;
	}

	:global([data-theme='dark']) .network-hub svg {
		stroke: rgb(var(--color-primary-strong));
	}

	/* ---- Roles ---- */

	.network-roles {
		position: relative;
		display: grid;
		gap: clamp(2.5rem, 6vw, 3rem) 1.5rem;
		margin: 0;
		padding: 4.5rem 0 0;
		list-style: none;
	}

	.network-role {
		position: relative;
		text-align: center;
	}

	.role-connector {
		position: absolute;
		top: -2.25rem;
		left: 50%;
		width: 1px;
		height: 2.25rem;
		background: rgb(var(--color-border));
	}

	.role-connector::after {
		position: absolute;
		top: -0.25rem;
		left: 50%;
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: rgb(var(--accent));
		content: '';
		transform: translateX(-50%);
	}

	.role-icon {
		display: inline-grid;
		width: 3.25rem;
		height: 3.25rem;
		place-items: center;
		border-radius: 50%;
		background: rgb(var(--accent-soft));
	}

	.role-icon svg {
		width: 1.375rem;
		height: 1.375rem;
		fill: none;
		stroke: rgb(var(--accent-ink));
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.role-title {
		margin: 1.125rem 0 0;
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.role-line {
		max-width: 16rem;
		margin: 0.375rem auto 0;
		color: rgb(var(--color-muted));
		font-size: 0.9375rem;
		line-height: 1.55;
	}

	.role-cta {
		margin-top: 0.875rem;
	}

	/* ---- Responsive ---- */

	/*
	 * Below 64rem the three columns would squeeze to under 200px each, too
	 * narrow for the connector geometry to read as a diagram. The roles stack
	 * as a plain list instead — still icon-led and one line each, just without
	 * the hub-and-spoke drawing, which needs three-across room to make sense.
	 */
	@media (max-width: 63.999rem) {
		.network-spine,
		.role-connector {
			display: none;
		}

		.network-roles {
			max-width: 26rem;
			margin-inline: auto;
			padding-top: 0;
		}

		.network-role + .network-role {
			padding-top: clamp(2rem, 5vw, 2.5rem);
			border-top: 1px solid rgb(var(--color-border));
			margin-top: clamp(2rem, 5vw, 2.5rem);
		}
	}

	@media (min-width: 64rem) {
		.network-roles {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
