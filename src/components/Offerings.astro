---
import SectionIntro from './SectionIntro.astro';
import { Accent, OfferingKind, SectionId, TrackEvent } from '../lib/constants';
import { OFFERINGS } from '../lib/content';

/** Analytics event per offering, resolved from the enum rather than inlined. */
const TRACK_BY_KIND: Readonly<Record<OfferingKind, TrackEvent>> = {
	[OfferingKind.AskForReferral]: TrackEvent.OfferingAsk,
	[OfferingKind.GiveReferral]: TrackEvent.OfferingGive,
	[OfferingKind.PeerSignal]: TrackEvent.OfferingPeer,
};

/*
 * Three doors in one wall.
 *
 * "One network, three ways in" is made structurally rather than drawn: three
 * cells inside a single bordered frame, divided by hairlines. Belonging to one
 * frame IS the argument, it holds at every width, and it rhymes with the wall
 * of doors in the hero.
 *
 * Each cell is a door, and the hover state is the thing that makes it one: a
 * wedge of light falls in from the left edge the way it does when a door opens
 * into a dark room, and the icon well lights up. `clip-path` and `opacity` do
 * all of it, with no layout and no paint of anything but the beam.
 *
 * A cell carries four things and no more: the icon, the title, one line, one
 * link. It had a chapter numeral and an accent rule as well, which is two more
 * pieces of furniture than an idea this simple can justify.
 *
 * The three accents are back. They were surrendered once (DESIGN_SYSTEM.md §16)
 * because `--color-primary-soft` and `--color-reward-soft` were the same triple
 * in dark mode, so two of three doors rendered identically. The token re-sync
 * fixed that at the source: ask is primary blue, give is success green, and
 * peer openings is the new `progress` teal — three hues that separate in both
 * themes, each already carrying the meaning it has inside the product.
 */
const DOOR_ACCENT: Readonly<Record<OfferingKind, Accent>> = {
	[OfferingKind.AskForReferral]: Accent.Primary,
	[OfferingKind.GiveReferral]: Accent.Success,
	[OfferingKind.PeerSignal]: Accent.Progress,
};

const ROLE_ICON: Readonly<Record<OfferingKind, string>> = {
	[OfferingKind.AskForReferral]: 'M3 14h10M9 9l4 5-4 5M16.5 4h8v20h-8',
	[OfferingKind.GiveReferral]: 'M5 14.5l5.5 5.5L23 7',
	[OfferingKind.PeerSignal]: 'M11 10a5.6 5.6 0 0 1 0 8M14.4 6.8a10 10 0 0 1 0 14.4',
};
---

<section class="section offerings" id={SectionId.Offerings} aria-labelledby="offerings-title">
	<div class="shell">
		<SectionIntro
			title="One network. Three ways in."
			headingId="offerings-title"
			align="center"
			class="reveal"
		/>

		<ul class="doors reveal">
			{
				OFFERINGS.map((offering) => (
					<li class:list={['door', `accent-${DOOR_ACCENT[offering.kind]}`]}>
						<span class="door-icon" aria-hidden="true">
							<svg viewBox="0 0 28 28">
								<path d={ROLE_ICON[offering.kind]} />
								{offering.kind === OfferingKind.PeerSignal && (
									<circle cx="7" cy="14" r="1.5" fill="currentColor" stroke="none" />
								)}
							</svg>
						</span>

						<h3 class="door-title">{offering.title}</h3>
						<p class="door-line">{offering.line}</p>

						<a class="text-link door-cta" href={offering.ctaHref} data-track={TRACK_BY_KIND[offering.kind]}>
							{offering.ctaLabel}
							<svg viewBox="0 0 16 16" aria-hidden="true">
								<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" />
							</svg>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/*
	 * The shared canvas, like every other section. Separation on this page comes
	 * from the frame below sitting ON the canvas, not from repainting the band —
	 * alternating section backgrounds reads as stripes, and it makes the page
	 * argue with itself rather than hold together.
	 */
	.offerings {
		border-top: 1px solid rgb(var(--color-border));
	}

	/*
	 * The frame. A 1px grid gap over an ink-tinted backdrop draws every divider
	 * — between and around the cells — in one declaration, and stays a true
	 * neutral in both themes. Drawing these in brand blue is the trap the trust
	 * section already documented: blue-on-blue vanishes in light mode.
	 */
	.doors {
		display: grid;
		gap: 1px;
		margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
		padding: 0;
		overflow: hidden;
		border: 1px solid rgb(var(--color-ink) / 14%);
		border-radius: var(--radius-xxl);
		background: rgb(var(--color-ink) / 12%);
		box-shadow: var(--shadow-raised);
		list-style: none;
	}

	/*
	 * `grid` + `1fr` on the copy row is what pins all three CTAs to a shared
	 * baseline no matter how the one-liners wrap. The cell is deliberately tall:
	 * three squat boxes read as a feature table, three tall ones read as doors.
	 */
	.door {
		position: relative;
		display: grid;
		min-height: 17rem;
		grid-template-rows: auto auto auto 1fr auto;
		align-content: start;
		padding: clamp(1.75rem, 3vw, 2.25rem);
		background: rgb(var(--color-surface));
		isolation: isolate;
	}

	/*
	 * The light. Closed, it is a sliver with no width at the left edge; open, it
	 * is the trapezoid a doorway throws across a floor. Only the clip-path and
	 * the opacity move.
	 *
	 * It is a pseudo-element on the cell rather than a child, so nothing in
	 * here has to reach past it to restack the cell's real content: a negative
	 * z-index inside the cell's own stacking context paints it over the cell
	 * background and under every word.
	 */
	.door::before {
		position: absolute;
		z-index: -1;
		inset: 0;
		background: linear-gradient(
			104deg,
			rgb(var(--accent) / 20%) 0%,
			rgb(var(--accent) / 7%) 38%,
			transparent 66%
		);
		clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
		content: '';
		opacity: 0;
		pointer-events: none;
		transition:
			clip-path 560ms var(--ease-out),
			opacity 320ms var(--ease-out);
	}

	.door:hover::before,
	.door:focus-within::before {
		clip-path: polygon(0 0, 66% 16%, 84% 94%, 0 100%);
		opacity: 1;
	}

	.door-icon {
		display: inline-grid;
		width: 3.25rem;
		height: 3.25rem;
		place-items: center;
		border-radius: 50%;
		background: rgb(var(--accent-soft));
		box-shadow: 0 0 0 0 rgb(var(--accent) / 0%);
		transition: box-shadow var(--dur-slow) var(--ease-out);
	}

	.door:hover .door-icon,
	.door:focus-within .door-icon {
		box-shadow: 0 0 0 0.5rem rgb(var(--accent) / 12%);
	}

	.door-icon svg {
		width: 1.5rem;
		height: 1.5rem;
		fill: none;
		stroke: rgb(var(--accent-ink));
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.door-title {
		margin: 1.5rem 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2vw, 1.75rem);
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.15;
	}

	.door-line {
		margin: 0.625rem 0 0;
		max-width: 20rem;
		color: rgb(var(--color-muted));
		font-size: 1rem;
		line-height: 1.55;
	}

	.door-cta {
		margin-top: 1.25rem;
		color: rgb(var(--accent-ink));
	}

	/* ---- Entrance ----
	   The frame arrives as one object, then its three cells resolve in turn.
	   No blur here: a blurred cell bleeds over the 1px dividers and makes the
	   frame's own lines flicker. */

	@media (prefers-reduced-motion: no-preference) {
		.doors.is-visible .door {
			animation: door-in 640ms var(--ease-out) both;
		}

		.doors.is-visible .door:nth-child(2) {
			animation-delay: 90ms;
		}

		.doors.is-visible .door:nth-child(3) {
			animation-delay: 180ms;
		}

		@keyframes door-in {
			from {
				opacity: 0;
				transform: translateY(0.75rem);
			}
			to {
				opacity: 1;
				transform: none;
			}
		}
	}

	/* ---- Responsive ----
	   Single column is the phone layout. The frame simply becomes three columns
	   from 64rem; nothing is hidden at any width. */

	@media (max-width: 63.999rem) {
		.door {
			min-height: 0;
		}
	}

	@media (min-width: 64rem) {
		.doors {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
