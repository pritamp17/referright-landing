---
import { SectionId } from '../lib/constants';
import { BRAND_MARK_PARTS, BRAND_WORDMARK_PATH, BRAND_LOCKUP_WIDTH } from '../lib/brand';

interface Props {
	href?: string;
	class?: string;
	label?: string;
	onBrandSurface?: boolean;
	size?: 'sm' | 'md';
}

const {
	href = `#${SectionId.Top}`,
	class: className = '',
	label = 'RightRefer home',
	onBrandSurface = false,
	size = 'md',
} = Astro.props;
---

<a
	class:list={['brand', `brand-${size}`, onBrandSurface && 'brand-on-surface', className]}
	href={href}
	aria-label={label}
>
	{/* Outlined lettering keeps spacing identical before fonts load and at every size. */}
	<svg viewBox={`0 0 ${BRAND_LOCKUP_WIDTH} 64`} width={BRAND_LOCKUP_WIDTH} height="64" aria-hidden="true" focusable="false">
		<g transform="scale(.666667)">
			{BRAND_MARK_PARTS.map(({ path, tone }) => <path class={`brand-piece brand-piece-${tone}`} d={path} />)}
		</g>
		<path d={BRAND_WORDMARK_PATH} />
	</svg>
</a>

<style>
	.brand {
		display: inline-flex;
		flex: 0 0 auto;
		min-height: 2.75rem;
		align-items: center;
		color: rgb(var(--color-ink));
	}

	.brand svg {
		display: block;
		width: 100%;
		height: auto;
		fill: currentColor;
	}

	.brand-sm { width: 9rem; }
	.brand-md { width: 11rem; }

	.brand-piece-primary { fill: rgb(var(--color-primary)); }
	.brand-piece-teal { fill: rgb(var(--color-brand-teal)); }
	.brand-piece-sky { fill: rgb(var(--color-brand-sky)); }

	.brand-on-surface {
		color: rgb(var(--color-brand-panel-ink));
	}

	.brand-on-surface .brand-piece { fill: currentColor; }
</style>
