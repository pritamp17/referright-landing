---
import BaseLayout from '../layouts/BaseLayout.astro';
import Appreciation from '../components/Appreciation.astro';
import ClosingSection from '../components/ClosingSection.astro';
import CompanyField from '../components/CompanyField.astro';
import Hero from '../components/Hero.astro';
import Lifecycle from '../components/Lifecycle.astro';
import Offerings from '../components/Offerings.astro';
import PeerSignalSection from '../components/PeerSignalSection.astro';
import SectionIntro from '../components/SectionIntro.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TestimonialStage, { type Testimonial } from '../components/TestimonialStage.astro';
import TrustSection from '../components/TrustSection.astro';
import { Accent, SectionId } from '../lib/constants';

const pageTitle = 'RightRefer — Get referred by someone who actually works there';
const pageDescription =
	'Ask for a referral at your target company. A LinkedIn-verified employee takes it on and submits it with proof, so you always know exactly where your request stands.';

const testimonialBatches: readonly (readonly Testimonial[])[] = [
	[
		{
			name: 'Aarav S.',
			role: 'Software engineer · Bengaluru',
			initials: 'AS',
			accent: Accent.Primary,
			quote: 'The context made my referral request feel natural instead of cold.',
		},
		{
			name: 'Maya R.',
			role: 'Product designer · Pune',
			initials: 'MR',
			accent: Accent.Reward,
			quote: 'I found someone whose team was actually hiring, not another random contact.',
		},
		{
			name: 'Neha P.',
			role: 'Senior developer · Chennai',
			initials: 'NP',
			accent: Accent.Success,
			quote: 'I could review the candidate and decide whether I could genuinely help.',
		},
	],
	[
		{
			name: 'Kabir N.',
			role: 'Cloud engineer · Gurugram',
			initials: 'KN',
			accent: Accent.Trust,
			quote: 'The right person saw my request and knew exactly which role I meant.',
		},
		{
			name: 'Ananya J.',
			role: 'UX researcher · Bengaluru',
			initials: 'AJ',
			accent: Accent.Primary,
			quote: 'It felt like starting a useful professional conversation, not asking a stranger.',
		},
		{
			name: 'Priya C.',
			role: 'Program manager · Hyderabad',
			initials: 'PC',
			accent: Accent.Reward,
			quote: 'I knew exactly where my request stood the whole way through.',
		},
	],
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<SiteHeader />

	<main id="main-content">
		<Hero />

		<section class="companies" aria-label="Companies people request referrals into">
			<div class="shell">
				<p class="companies-label">Requests are open at companies like</p>
			</div>
			<CompanyField />
		</section>

		<Offerings />
		<PeerSignalSection />
		<Lifecycle />
		<TrustSection />
		<Appreciation />

		<section class="section stories" id={SectionId.Stories} aria-labelledby="stories-title">
			<div class="shell">
				<SectionIntro
					eyebrow="From the private beta"
					title="What people told us."
					copy="Feedback from seekers and referrers who used RightRefer during the beta."
					headingId="stories-title"
					align="center"
					class="reveal"
				/>
			</div>
			<div class="stories-stage reveal">
				<TestimonialStage batches={testimonialBatches} />
			</div>
		</section>

		<ClosingSection />
	</main>
</BaseLayout>

<script>
	/* Progressive reveal. When motion is reduced the stylesheet already shows
	   everything, so this only ever adds polish and never gates content. */
	const revealables = document.querySelectorAll<HTMLElement>('.reveal');

	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
		revealables.forEach((element) => element.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				}
			},
			{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
		);

		revealables.forEach((element) => observer.observe(element));
	}
</script>

<style>
	.companies {
		display: grid;
		gap: 1.25rem;
		padding-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.companies-label {
		margin: 0;
		color: rgb(var(--color-muted));
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		text-align: center;
	}

	.stories {
		border-top: 1px solid rgb(var(--color-border));
	}

	.stories-stage {
		margin-top: clamp(2rem, 4vw, 3rem);
	}
</style>
