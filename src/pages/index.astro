---
import BaseLayout from '../layouts/BaseLayout.astro';
import BetaProof from '../components/BetaProof.astro';
import ClosingSection from '../components/ClosingSection.astro';
import CompanyField from '../components/CompanyField.astro';
import Faq from '../components/Faq.astro';
import DesignLab from '../components/DesignLab.astro';
import Hero from '../components/Hero.astro';
import ProductStory from '../components/ProductStory.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { type Testimonial } from '../components/TestimonialStage.astro';
import { Accent, SectionId } from '../lib/constants';

const pageTitle = 'RightRefer: The right referral. Your way in.';
const pageDescription =
	'Ask for a referral, give one when you can, or hear about openings before they go public through a trusted network of verified employees and peers.';

const testimonialBatches: readonly (readonly Testimonial[])[] = [
	[
		{
			name: 'Aarav S.',
			role: 'Software engineer · Bengaluru',
			initials: 'AS',
			accent: Accent.Primary,
			quote: 'The context made my referral request feel natural instead of cold.',
		},
		{
			name: 'Maya R.',
			role: 'Product designer · Pune',
			initials: 'MR',
			accent: Accent.Reward,
			quote: 'I found someone whose team was actually hiring, not another random contact.',
		},
		{
			name: 'Neha P.',
			role: 'Senior developer · Chennai',
			initials: 'NP',
			accent: Accent.Success,
			quote: 'I could review the candidate and decide whether I could genuinely help.',
		},
	],
	[
		{
			name: 'Kabir N.',
			role: 'Cloud engineer · Gurugram',
			initials: 'KN',
			accent: Accent.Trust,
			quote: 'The right person saw my request and knew exactly which role I meant.',
		},
		{
			name: 'Ananya J.',
			role: 'UX researcher · Bengaluru',
			initials: 'AJ',
			accent: Accent.Primary,
			quote: 'It felt like starting a useful professional conversation, not asking a stranger.',
		},
		{
			name: 'Priya C.',
			role: 'Program manager · Hyderabad',
			initials: 'PC',
			accent: Accent.Reward,
			quote: 'I knew exactly where my request stood the whole way through.',
		},
	],
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<SiteHeader />

	<main id="main-content">
		<Hero />

		{/* Part of the opening block rather than a section of its own: one thin
		    band of proof directly under the hero, with no heading. */}
		<section
			class="companies reveal"
			id={SectionId.Value}
			aria-label="Companies people request referrals into"
		>
			<div class="shell">
				<p class="companies-label">Requests are open at companies like</p>
			</div>
			<CompanyField />
		</section>

		{/*
		  * Proof before mechanism.
		  *
		  * The companies band and the beta quotes are the two cheapest things
		  * to read on the page and the two most likely to earn the next scroll,
		  * so they come first. Only then is it worth spending a reader's
		  * attention on how the thing works, and the questions land last,
		  * where somebody who is nearly convinced goes looking for the one
		  * detail that still bothers them.
		  */}
		<BetaProof batches={testimonialBatches} />
		<ProductStory />
		<Faq />
		<ClosingSection />
	</main>

	{/* Development-only design preview. Removes itself on a production build
	    unless the page is loaded with `?design`. */}
	<DesignLab />
</BaseLayout>

<script>
	import { revealObserver } from '../lib/motion';

	revealObserver();
</script>

<style>
	/*
	 * The hero now owns the whole first screen, so this band is the first thing
	 * a scroll reveals. It gets its own top padding rather than borrowing the
	 * hero's, so the logos arrive as a deliberate second beat.
	 */
	.companies {
		display: grid;
		gap: 1.5rem;
		padding-top: clamp(3rem, 6vw, 4.5rem);
		padding-bottom: clamp(3rem, 6vw, 4.5rem);
	}

	.companies-label {
		margin: 0;
		color: rgb(var(--color-muted));
		font-size: 0.8125rem;
		font-weight: 550;
		letter-spacing: 0.025em;
		text-align: center;
	}
</style>
