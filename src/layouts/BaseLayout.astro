---
import Analytics from '@vercel/analytics/astro';
import { THEME_STORAGE_KEY, ThemeMode } from '../lib/constants';
import { FAQ_ITEMS } from '../lib/content';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL('/og-image.png', canonicalUrl);

/*
 * Prepaint theme resolution.
 *
 * This must run before first paint, synchronously, in <head> — otherwise a
 * returning dark-mode visitor gets a full-brightness flash of the light canvas
 * before hydration corrects it. Astro's `is:inline` keeps it out of the bundle
 * graph so it is not deferred.
 *
 * A first visit follows the operating system. Only an explicit choice from the
 * toggle is stored, and from then on it wins over the system setting; until
 * somebody makes that choice the page tracks `prefers-color-scheme` live.
 *
 * Note that the product application still defaults to light on a first visit
 * and shares this storage key, so a visitor whose system is dark sees a dark
 * landing page and a light application until they touch the toggle. Closing
 * that gap means changing the application's default too.
 *
 * The enum values are interpolated from `constants.ts` rather than hardcoded, so
 * the inline script cannot drift from the typed source.
 *
 * It also stamps `js` on <html>. Every scroll-reveal rule is gated behind that
 * class, so a visitor whose bundle never loads reads a fully visible page
 * instead of a blank one.
 */
const themePrepaint = `(function(){try{
	var stored = localStorage.getItem(${JSON.stringify(THEME_STORAGE_KEY)});
	var explicit = (stored === ${JSON.stringify(ThemeMode.Dark)} || stored === ${JSON.stringify(ThemeMode.Light)});
	var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
	var theme = explicit
		? stored
		: (prefersDark ? ${JSON.stringify(ThemeMode.Dark)} : ${JSON.stringify(ThemeMode.Light)});
	document.documentElement.dataset.theme = theme;
	document.documentElement.classList.add('js');
	var meta = document.querySelector('meta[name="theme-color"]');
	if (meta) meta.setAttribute('content', theme === ${JSON.stringify(ThemeMode.Dark)} ? '#050505' : '#FBF8F2');
}catch(e){document.documentElement.dataset.theme = ${JSON.stringify(ThemeMode.Light)};document.documentElement.classList.add('js');}})();`;
---

<!doctype html>
<html lang="en" data-theme={ThemeMode.Light}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#FBF8F2" />

		<script is:inline set:html={themePrepaint} />

		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		{/* The hero drawing is a mask image served from /public. Preloading it
		    means the ink-wipe starts on a drawing that is already there. */}
		<link rel="preload" href="/ink-doors-mask.webp" as="image" type="image/webp" />
		<link rel="preload" href="/Louize.woff2" as="font" type="font/woff2" crossorigin />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
		/>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="RightRefer" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />

		<title>{title}</title>

		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'Organization',
				name: 'RightRefer',
				url: canonicalUrl.origin,
				description,
			})}
		/>

		{/*
		 * FAQ structured data, generated from the same array the FAQ section
		 * renders so the two cannot drift.
		 *
		 * Worth being clear about what this does and does not buy: Google
		 * retired FAQ rich results on 2026-05-07 (they now show only for
		 * authoritative government and health sites) and the Search Console FAQ
		 * report went with it. So this earns no rich result. It stays because it
		 * describes the Q&A structure to AI search surfaces, and because unused
		 * structured data is harmless — but nobody should expect stars in the
		 * SERP from it.
		 */}
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'FAQPage',
				mainEntity: FAQ_ITEMS.map((item) => ({
					'@type': 'Question',
					name: item.question,
					acceptedAnswer: { '@type': 'Answer', text: item.answer },
				})),
			})}
		/>
		<Analytics />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<slot />
	</body>
</html>
